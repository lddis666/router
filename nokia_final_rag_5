        action accept
            aigp-metric 15000
        exit
    exit
    default-action accept
exit
commit

/configure router bgp
group "YOUR_GROUP"  # Replace with your BGP group name
    aigp
    export "SET_DEFAULT_AIGP"
exit
```

### Key details:
