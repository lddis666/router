```cli
# Create a policy to match routes from specific BGP peers
/configure router policy-options
begin
prefix-list "PEER_NEXT_HOPS"
    prefix <peer-next-hop-1>/32 exact
    prefix <peer-next-hop-2>/32 exact
    # Add more peer next-hop prefixes as needed
exit
policy-statement "SR_STEERING_POLICY"
    entry 10
        from
            prefix-list "PEER_NEXT_HOPS"
        exit
        action accept
        exit
    exit
