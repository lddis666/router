{
    "PageTitle": "local-as",
    "FuncDef": "This command configures a BGP local autonomous system (AS) number. In addition to the global AS number configured for BGP using the autonomous-system command, a local AS number can be configured to support various AS number migration scenarios.",
    "CLIs": [
        "local-as <as-number> [ private ] [ <no-prepend-global-as> ]",
        "no local-as"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "as-number",
            "Info": "Specifies the virtual autonomous system number expressed as a decimal integer. Values-1 to 4294967295."
        },
        {
            "Parameters": "private",
            "Info": "Specifies the local-as is hidden in paths learned from the peering."
        },
        {
            "Parameters": "no-prepend-global-as",
            "Info": "Specifies that the global-as is hidden in paths announced to the BGP peer."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no local-as"
