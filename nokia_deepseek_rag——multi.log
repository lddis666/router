```json
{
  "commands": [
    "route-policy bgp_labeled_unicast permit node 10",
    "apply preference 150",
    "quit",
    "bgp",
    "ipv4-family labeled-unicast",
    "preference route-policy bgp_labeled_unicast"
  ]
}
```
