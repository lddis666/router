input_text
You are an expert assistant in configuring network devices. Based on the user's request and the retrieved content from the router configuration manual below, generate appropriate CLI configuration commands.

---

User Request:  
How to configure Nokia routers to advertise IPv6 multicast routes from a VPRN over the provider network using BGP?

Retrieved Reference Content (from the configuration manual):  
{
    "PageTitle": "ignore-router-id",
    "FuncDef": "When theignore-router-idcommand is present, and the current best path to a destination was learned from EBGP peer X with BGP identifier x and a new path is received from EBGP peer Y with BGP identifier y, the best path remains unchanged if the new path is equivalent to the current best path up to the BGP identifier comparison - even if y is less than x.",
    "CLIs": [
        "ignore-router-id include-internal <family> [ <family> ]",
        "[ no ] ignore-router-id"
    ],
    "ParentView": [
        "config>router>bgp>best-path-selection",
        "config>service>vprn>bgp>best-path-selection"
    ],
    "ParaDef": [
        {
            "Parameters": "family",
            "Info": "Specifies up to two internal families to be included in this configuration. Values-mvpn-ipv4, mvpn-ipv6."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no ignore-router-id"
}
{
    "PageTitle": "local-as",
    "FuncDef": "This command configures a BGP local autonomous system (AS) number. In addition to the global AS number configured for BGP using the autonomous-system command, a local AS number can be configured to support various AS number migration scenarios.",
    "CLIs": [
        "local-as <as-number> [ private ] [ <no-prepend-global-as> ]",
        "no local-as"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "as-number",
            "Info": "Specifies the virtual autonomous system number expressed as a decimal integer. Values-1 to 4294967295."
        },
        {
            "Parameters": "private",
            "Info": "Specifies the local-as is hidden in paths learned from the peering."
        },
        {
            "Parameters": "no-prepend-global-as",
            "Info": "Specifies that the global-as is hidden in paths announced to the BGP peer."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no local-as"
}
{
    "PageTitle": "enable-inter-as-vpn",
    "FuncDef": "This command specifies whether VPNs can exchange routes across autonomous system boundaries, providing model B connectivity",
    "CLIs": [
        "enable-inter-as-vpn",
        "no enable-inter-as-vpn"
    ],
    "ParentView": [
        "config>router>bgp"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no enable-inter-as-vpn"
}
{
    "PageTitle": "mcast-vpn-ipv4",
    "FuncDef": "This command configures the add-paths capability for multicast IPv4 VPN routes. By default, add-paths is not enabled for multicast IPv4 VPN routes.",
    "CLIs": [
        "mcast-vpn-ipv4 send <send-limit> receive [ none ]",
        "mcast-vpn-ipv4 send <send-limit>",
        "no mcast-vpn-ipv4"
    ],
    "ParentView": [
        "config>router>bgp>add-paths",
        "config>router>bgp>group>add-paths",
        "config>router>bgp>group>neighbor>add-paths"
    ],
    "ParaDef": [
        {
            "Parameters": "send-limit",
            "Info": "Specifies the maximum number of paths per multicast IPv4 VPN prefix that are allowed to be advertised to add-paths peers. The actual number of advertised routes may be less. If the value is none, the router does not negotiate the send capability with respect to multicast IPv4 VPN AFI/SAFI. Values-1 to 16, none."
        },
        {
            "Parameters": "receive",
            "Info": "Specifies that the router negotiates to receive multiple multicast routes per IPv4 VPN prefix."
        },
        {
            "Parameters": "none",
            "Info": "Specifies that the router does not negotiate to receive multiple multicast routes per IPv4 VPN prefix."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no mcast-vpn-ipv4"
}
{
    "PageTitle": "aggregator-id-zero",
    "FuncDef": "This command sets the router ID in the BGP aggregator path attribute to zero when BGP aggregates routes. This prevents different routers within an AS from creating aggregate routes that contain different AS paths.",
    "CLIs": [
        "aggregator-id-zero",
        "no aggregator-id-zero"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no aggregator-id-zero"
}
{
    "PageTitle": "type",
    "FuncDef": "This command designates the BGP peer as type internal or external.",
    "CLIs": [
        "type { internal | external }",
        "no type { internal | external }"
    ],
    "ParentView": [
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "internal",
            "Info": "Configures the peer as internal."
        },
        {
            "Parameters": "external",
            "Info": "Configures the peer as external."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no type"
}
{
    "PageTitle": "stats-report-interval",
    "FuncDef": "This command configures the frequency of sending statistics reporting messages to the BMP monitoring station",
    "CLIs": [
        "stats-report-interval [ <seconds> ]",
        "no stats-report-interval"
    ],
    "ParentView": [
        "config>bmp>station"
    ],
    "ParaDef": [
        {
            "Parameters": "seconds",
            "Info": "Specifies the frequency of sending statistics reporting messages, in seconds, to the BMP monitoring station. Values-15 to 65535."
        }
    ],
    "Examples": null,
    "ExtraInfo": ""
}
{
    "PageTitle": "primary-ipv6-address",
    "FuncDef": "This command specifies the primary IPv6 address of a reference location used for BGP optimal route reflection. Up to three IPv4 addresses and three IPv6 addresses can be specified per location.",
    "CLIs": [
        "primary-ipv6-address <ipv6-address>",
        "no primary-ipv6-address"
    ],
    "ParentView": [
        "config>router>bgp>orr>location"
    ],
    "ParaDef": [
        {
            "Parameters": "ipv6-address",
            "Info": "Specifies the primary IPv6 address of a location expressed in dotted decimal notation. Values-ipv6-address:."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no primary-ipv6-address"
}
{
    "PageTitle": "vpn-apply-import",
    "FuncDef": "This command causes the base instance BGP import route policies to be applied to vpn-ipv4/6, mvpn-ipv4/6, l2-vpn, mdt-safi, mcast-vpn-ipv4, and evpn routes.",
    "CLIs": [
        "vpn-apply-import",
        "no vpn-apply-import"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no vpn-apply-import"
}
{
    "PageTitle": "secondary-ipv6-address",
    "FuncDef": "This command specifies the secondary IPv6 address of a reference location used for BGP optimal route reflection. Up to three IPv4 addresses and three IPv6 addresses can be specified per location.",
    "CLIs": [
        "secondary-ipv6-address <ipv6-address>",
        "no secondary-ipv6-address"
    ],
    "ParentView": [
        "config>router>bgp>orr>location"
    ],
    "ParaDef": [
        {
            "Parameters": "ipv6-address",
            "Info": "Specifies the secondary IPv6 address of a location. Values-ipv6-address:."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no secondary-ipv6-address"
}
{
    "PageTitle": "passive",
    "FuncDef": "Enables/disables passive mode for the BGP group or neighbor.",
    "CLIs": [
        "passive",
        "no passive"
    ],
    "ParentView": [
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no passive"
}
{
    "PageTitle": "resolution-filter",
    "FuncDef": "This command enters the configuration mode to set resolution filter types.",
    "CLIs": [
        "resolution-filter"
    ],
    "ParentView": [
        "config>router>bgp>next-hop-resolution>labeled-routes>transport-tunnel>family"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": ""
}
{
    "PageTitle": "monitor",
    "FuncDef": "This command enables the context to configure monitor parameters.",
    "CLIs": [
        "monitor",
        "no monitor"
    ],
    "ParentView": [
        "config>router>bgp>monitor",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor",
        "config>service>vprn>bgp>group",
        "config>service>vprn>bgp>group>neighbor"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": ""
}
{
    "PageTitle": "local-address",
    "FuncDef": "This command configures the local IP address used by the group or neighbor when communicating with BGP peers.",
    "CLIs": [
        "local-address [ <ip-int-name> | <ip-address> | <ipv6-address> ]",
        "no local-address"
    ],
    "ParentView": [
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "ip-address",
            "Info": "Specifies the local address expressed in dotted decimal notation. Allowed value is a valid routable IP address on the router, either an interface or system IP address. Values-ipv4-address:."
        },
        {
            "Parameters": "ipv6-address",
            "Info": "Specifies the local address expressed in dotted decimal notation. Allowed value is a valid routable IPv6 address on the router, either an interface or system IPv6 address. Values-ipv6-address:."
        },
        {
            "Parameters": "ip-int-name",
            "Info": "Specifies the IP interface name whose address the local address will inherit. The interface can be any network interface configured on the system."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no local-address"
}
{
    "PageTitle": "next-hop-resolution",
    "FuncDef": "This command enables the context to configure next-hop resolution parameters.",
    "CLIs": [
        "next-hop-resolution"
    ],
    "ParentView": [
        "config>router>bgp"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": ""
}
{
    "PageTitle": "as-path-ignore",
    "FuncDef": "This command configures whether AS path length is considered in the selection of the best BGP route for a prefix.",
    "CLIs": [
        "as-path-ignore [ ipv4 ] [ label-ipv4 ] [ vpn-ipv4 ] [ ipv6 ] [ label-ipv6 ] [ vpn-ipv6 ] [ mcast-ipv4 ] [ mcast-ipv6 ] [ mvpn-ipv4 ] [ mvpn-ipv6 ] [ l2-vpn ]",
        "no as-path-ignore"
    ],
    "ParentView": [
        "config>router>bgp>best-path-selection"
    ],
    "ParaDef": [
        {
            "Parameters": "ipv4",
            "Info": "Specifies that the AS-path length will be ignored for all unlabeled unicast IPv4 routes."
        },
        {
            "Parameters": "label-ipv4",
            "Info": "Specifies that the AS-path length will be ignored for all labeled-unicast IPv4 routes."
        },
        {
            "Parameters": "vpn-ipv4",
            "Info": "Specifies that the length AS-path will be ignored for all IPv4 VPRN (SAFI 128) routes."
        },
        {
            "Parameters": "ipv6",
            "Info": "Specifies that the AS-path length will be ignored for all unlabeled unicast IPv6 routes."
        },
        {
            "Parameters": "label-ipv6",
            "Info": "Specifies that the AS-path length will be ignored for all labeled-unicast IPv6 routes."
        },
        {
            "Parameters": "vpn-ipv6",
            "Info": "Specifies that the AS-path length will be ignored for all IPv6 VPRN (SAFI 128) routes."
        },
        {
            "Parameters": "mcast-ipv4",
            "Info": "Specifies that the AS-path length will be ignored for all IPv4 multicast routes."
        },
        {
            "Parameters": "mcast-ipv6",
            "Info": "Specifies that the AS-path length will be ignored for all IPv6 multicast routes."
        },
        {
            "Parameters": "mvpn-ipv4",
            "Info": "Specifies that the AS-path length will be ignored for all IPv4 MVPN routes."
        },
        {
            "Parameters": "mvpn-ipv6",
            "Info": "Specifies that the AS-path length will be ignored for all IPv6 MVPN routes."
        },
        {
            "Parameters": "l2-vpn",
            "Info": "The AS-path length will be ignored for all L2-VPN NLRIs."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no as-path-ignore"
}
{
    "PageTitle": "peer-as",
    "FuncDef": "This command configures the autonomous system number for the remote peer. The peer AS number must be configured for each configured peer.",
    "CLIs": [
        "peer-as <as-number>"
    ],
    "ParentView": [
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "as-number",
            "Info": "Specifies the autonomous system number expressed as a decimal integer. Values-1 to 4294967295."
        }
    ],
    "Examples": null,
    "ExtraInfo": ""
}
{
    "PageTitle": "advertise-ipv6-next-hops",
    "FuncDef": "This command applies to a BGP session established on top of IPv6; transport, BGP routes belonging to the specified families can be advertised with a true IPv6 address when originated or whennext-hop-self(configured or automatic) is applied.",
    "CLIs": [
        "advertise-ipv6-next-hops [ vpn-ipv6 ] [ label-ipv6 ] [ vpn-ipv4 ] [ label-ipv4 ]",
        "no advertise-ipv6-next-hops"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "vpn-ipv6",
            "Info": "Allows VPN IPv6 routes to be advertised to IPv6 transport peers with an IPv6 address as the BGP next hop in cases of route origination or next-hop-self (configured or automatic)."
        },
        {
            "Parameters": "label-ipv6",
            "Info": "Allows label IPv6 routes to be advertised to IPv6 transport peers with an IPv6 address as the BGP next hop in cases of route origination or next-hop-self (configured or automatic)."
        },
        {
            "Parameters": "vpn-ipv4",
            "Info": "Allows VPN IPv4 routes to be advertised to IPv6 transport peers with an IPv6 address as the BGP next hop in cases of route origination or next-hop-self (configured or automatic). It also allows export policies to change the BGP next hop of a VPN IPv4 route to an IPv6 address. All of these cases require the remote peer to advertise the necessary extended NH encoding capability."
        },
        {
            "Parameters": "label-ipv4",
            "Info": "Allows label IPv4 routes to be advertised to IPv6 transport peers with an IPv6 address as the BGP next hop in cases of route origination or next-hop-self (configured or automatic). It also allows export policies to change the BGP next hop of a label IPv4 route to an IPv6 address. All of these cases require the remote peer to advertise the necessary extended NH encoding capability."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no advertise-ipv6-next-hops"
}
{
    "PageTitle": "rib-management",
    "FuncDef": "This command enables the context to configure RIB management parameters.",
    "CLIs": [
