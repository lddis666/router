You are an expert assistant in configuring network devices. Based on the user's request and the retrieved content from the router configuration manual below, generate appropriate CLI configuration commands.

---

User Request:  
"How to configure Nokia router BGP to perform origin validation for both labeled IPv6 routes and unlabeled IPv4 routes from a specific peer?"

Retrieved Reference Content (from the configuration manual):  
{
    "PageTitle": "origin-invalid-unusable",
    "FuncDef": "Whenorigin-invalid-unusableis configured, all routes that have an origin validation state of  Invalid  are considered unusable by the best path selection algorithm, meaning they are not used for forwarding and not advertised to BGP peers.",
    "CLIs": [
        "origin-invalid-unusable",
        "no origin-invalid-unusable"
    ],
    "ParentView": [
        "config>router>bgp>best-path-selection"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no origin-invalid-unusable"
}
{
    "PageTitle": "flowspec",
    "FuncDef": "This command enables the context to enable and disable flowspec validations.",
    "CLIs": [
        "flowspec"
    ],
    "ParentView": [
        "config>router>bgp"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": ""
}
{
    "PageTitle": "local-address",
    "FuncDef": "This command configures the local IP address used by the group or neighbor when communicating with BGP peers.",
    "CLIs": [
        "local-address [ <ip-int-name> | <ip-address> | <ipv6-address> ]",
        "no local-address"
    ],
    "ParentView": [
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "ip-address",
            "Info": "Specifies the local address expressed in dotted decimal notation. Allowed value is a valid routable IP address on the router, either an interface or system IP address. Values-ipv4-address:."
        },
        {
            "Parameters": "ipv6-address",
            "Info": "Specifies the local address expressed in dotted decimal notation. Allowed value is a valid routable IPv6 address on the router, either an interface or system IPv6 address. Values-ipv6-address:."
        },
        {
            "Parameters": "ip-int-name",
            "Info": "Specifies the IP interface name whose address the local address will inherit. The interface can be any network interface configured on the system."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no local-address"
}
{
    "PageTitle": "connect-retry",
    "FuncDef": "This command configures the BGP connect retry timer value in seconds.",
    "CLIs": [
        "connect-retry <seconds>",
        "no connect-retry"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "seconds",
            "Info": "The BGP Connect Retry timer value in seconds expressed as a decimal integer. Values-1 to 65535."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: connect-retry 120"
}
{
    "PageTitle": "peer-as",
    "FuncDef": "This command configures the autonomous system number for the remote peer. The peer AS number must be configured for each configured peer.",
    "CLIs": [
        "peer-as <as-number>"
    ],
    "ParentView": [
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "as-number",
            "Info": "Specifies the autonomous system number expressed as a decimal integer. Values-1 to 4294967295."
        }
    ],
    "Examples": null,
    "ExtraInfo": ""
}
{
    "PageTitle": "advertise-ipv6-next-hops",
    "FuncDef": "This command applies to a BGP session established on top of IPv6; transport, BGP routes belonging to the specified families can be advertised with a true IPv6 address when originated or whennext-hop-self(configured or automatic) is applied.",
    "CLIs": [
        "advertise-ipv6-next-hops [ vpn-ipv6 ] [ label-ipv6 ] [ vpn-ipv4 ] [ label-ipv4 ]",
        "no advertise-ipv6-next-hops"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "vpn-ipv6",
            "Info": "Allows VPN IPv6 routes to be advertised to IPv6 transport peers with an IPv6 address as the BGP next hop in cases of route origination or next-hop-self (configured or automatic)."
        },
        {
            "Parameters": "label-ipv6",
            "Info": "Allows label IPv6 routes to be advertised to IPv6 transport peers with an IPv6 address as the BGP next hop in cases of route origination or next-hop-self (configured or automatic)."
        },
        {
            "Parameters": "vpn-ipv4",
            "Info": "Allows VPN IPv4 routes to be advertised to IPv6 transport peers with an IPv6 address as the BGP next hop in cases of route origination or next-hop-self (configured or automatic). It also allows export policies to change the BGP next hop of a VPN IPv4 route to an IPv6 address. All of these cases require the remote peer to advertise the necessary extended NH encoding capability."
        },
        {
            "Parameters": "label-ipv4",
            "Info": "Allows label IPv4 routes to be advertised to IPv6 transport peers with an IPv6 address as the BGP next hop in cases of route origination or next-hop-self (configured or automatic). It also allows export policies to change the BGP next hop of a label IPv4 route to an IPv6 address. All of these cases require the remote peer to advertise the necessary extended NH encoding capability."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no advertise-ipv6-next-hops"
}
{
    "PageTitle": "compare-origin-validation-state",
    "FuncDef": "When this command is configured, a new step is inserted in the BGP decision process after removal of invalid routes and before the comparison of Local Preference. The new step compares the origin validation state so that a BGP route with a  Valid  state is preferred over a BGP route with a  Not-Found  state, and a BGP route with a  Not-Found  state is preferred over a BGP route with an  Invalid  state assuming that these routes are considered  usable .",
    "CLIs": [
        "compare-origin-validation-state",
        "no compare-origin-validation-state"
    ],
    "ParentView": [
        "config>router>bgp>best-path-selection"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no compare-origin-validation-state"
}
{
    "PageTitle": "group",
    "FuncDef": "This command creates a context to configure a BGP peer group.",
    "CLIs": [
        "group <name>",
        "no group <name>"
    ],
    "ParentView": [
        "config>router>bgp"
    ],
    "ParaDef": [
        {
            "Parameters": "name",
            "Info": "Specifies the peer group name. Allowed values are any string up to 32 characters long composed of printable, 7-bit ASCII characters. If the string contains special characters (#, $, spaces, and so on), the entire string must be enclosed within double quotes."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no group"
}
{
    "PageTitle": "optimal-route-reflection",
    "FuncDef": "This command creates the optimal route reflection context.",
    "CLIs": [
        "optimal-route-reflection"
