    "CLIs": [
        "enable-inter-as-vpn",
        "no enable-inter-as-vpn"
    ],
    "ParentView": [
        "config>router>bgp"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no enable-inter-as-vpn"
}
