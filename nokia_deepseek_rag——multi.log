{
    "PageTitle": "enforce-first-as",
    "FuncDef": "When this command is configured so that it applies to an EBGP session, all routes (belonging to all address families) that are received from the EBGP peer are checked to ensure that the most recent autonomous system number (ASN) in the AS_PATH attribute of each route matches the configuredpeer-asof the session; if it does not match, then either the session is reset (ifupdate-fault-toleranceis not enabled) or the session is left up but the route is treated as withdrawn (ifupdate-fault-toleranceis enabled).",
    "CLIs": [
        "enforce-first-as"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": ""
}
{
    "PageTitle": "third-party-nexthop",
    "FuncDef": "Use this command to enable the router to send third-party next-hop to EBGP peers in the same subnet as the source peer, as described in RFC 4271. If enabled when an IPv4 or IPv6 route is received from one EBGP peer and advertised to another EBGP peer in the same IP subnet, the BGP next-hop is left unchanged. Third-party next-hop is not done if the address family of the transport does not match the address family of the route.",
    "CLIs": [
        "third-party-nexthop",
        "no third-party-nexthop"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no third-party-nexthop"
}
{
    "PageTitle": "send-to-ebgp",
    "FuncDef": "This command configures BGP to allow link-bandwidth extended community to be sent in routes advertised to EBGP peers in the scope of the command, as long the routes belong to one of the listed address families.",
    "CLIs": [
        "send-to-ebgp <family> [ <family> ]",
        "no send-to-ebgp"
    ],
    "ParentView": [
        "config>router>bgp>group>link-bandwidth",
        "config>router>bgp>group>neighbor>link-bandwidth"
    ],
    "ParaDef": [
        {
            "Parameters": "family",
            "Info": "Specifies the address families for which receiving the link-bandwidth extended community from EBGP peers should be supported. Values-ipv4 - Adds a link-bandwidth extended community to unlabeled unicast IPv4 routes.."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no send-to-ebgp"
}
{
    "PageTitle": "monitor",
    "FuncDef": "This command enables the context to configure monitor parameters.",
    "CLIs": [
        "monitor",
        "no monitor"
    ],
    "ParentView": [
        "config>router>bgp>monitor",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor",
        "config>service>vprn>bgp>group",
        "config>service>vprn>bgp>group>neighbor"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": ""
}
{
    "PageTitle": "connect-retry",
    "FuncDef": "This command configures the BGP connect retry timer value in seconds.",
    "CLIs": [
        "connect-retry <seconds>",
        "no connect-retry"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "seconds",
            "Info": "The BGP Connect Retry timer value in seconds expressed as a decimal integer. Values-1 to 65535."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: connect-retry 120"
}
{
    "PageTitle": "next-hop-resolution",
    "FuncDef": "This command enables the context to configure next-hop resolution parameters.",
    "CLIs": [
        "next-hop-resolution"
    ],
    "ParentView": [
        "config>router>bgp"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": ""
}
{
    "PageTitle": "as-path-ignore",
    "FuncDef": "This command configures whether AS path length is considered in the selection of the best BGP route for a prefix.",
    "CLIs": [
        "as-path-ignore [ ipv4 ] [ label-ipv4 ] [ vpn-ipv4 ] [ ipv6 ] [ label-ipv6 ] [ vpn-ipv6 ] [ mcast-ipv4 ] [ mcast-ipv6 ] [ mvpn-ipv4 ] [ mvpn-ipv6 ] [ l2-vpn ]",
        "no as-path-ignore"
    ],
    "ParentView": [
        "config>router>bgp>best-path-selection"
    ],
    "ParaDef": [
        {
            "Parameters": "ipv4",
            "Info": "Specifies that the AS-path length will be ignored for all unlabeled unicast IPv4 routes."
        },
        {
            "Parameters": "label-ipv4",
            "Info": "Specifies that the AS-path length will be ignored for all labeled-unicast IPv4 routes."
        },
        {
            "Parameters": "vpn-ipv4",
            "Info": "Specifies that the length AS-path will be ignored for all IPv4 VPRN (SAFI 128) routes."
        },
        {
            "Parameters": "ipv6",
            "Info": "Specifies that the AS-path length will be ignored for all unlabeled unicast IPv6 routes."
        },
        {
            "Parameters": "label-ipv6",
            "Info": "Specifies that the AS-path length will be ignored for all labeled-unicast IPv6 routes."
        },
        {
            "Parameters": "vpn-ipv6",
            "Info": "Specifies that the AS-path length will be ignored for all IPv6 VPRN (SAFI 128) routes."
        },
        {
            "Parameters": "mcast-ipv4",
            "Info": "Specifies that the AS-path length will be ignored for all IPv4 multicast routes."
        },
        {
            "Parameters": "mcast-ipv6",
            "Info": "Specifies that the AS-path length will be ignored for all IPv6 multicast routes."
        },
        {
            "Parameters": "mvpn-ipv4",
            "Info": "Specifies that the AS-path length will be ignored for all IPv4 MVPN routes."
        },
        {
            "Parameters": "mvpn-ipv6",
            "Info": "Specifies that the AS-path length will be ignored for all IPv6 MVPN routes."
        },
        {
            "Parameters": "l2-vpn",
            "Info": "The AS-path length will be ignored for all L2-VPN NLRIs."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no as-path-ignore"
}
{
    "PageTitle": "advertise-ipv6-next-hops",
    "FuncDef": "This command applies to a BGP session established on top of IPv6; transport, BGP routes belonging to the specified families can be advertised with a true IPv6 address when originated or whennext-hop-self(configured or automatic) is applied.",
    "CLIs": [
        "advertise-ipv6-next-hops [ vpn-ipv6 ] [ label-ipv6 ] [ vpn-ipv4 ] [ label-ipv4 ]",
        "no advertise-ipv6-next-hops"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "vpn-ipv6",
            "Info": "Allows VPN IPv6 routes to be advertised to IPv6 transport peers with an IPv6 address as the BGP next hop in cases of route origination or next-hop-self (configured or automatic)."
        },
        {
            "Parameters": "label-ipv6",
            "Info": "Allows label IPv6 routes to be advertised to IPv6 transport peers with an IPv6 address as the BGP next hop in cases of route origination or next-hop-self (configured or automatic)."
        },
        {
            "Parameters": "vpn-ipv4",
            "Info": "Allows VPN IPv4 routes to be advertised to IPv6 transport peers with an IPv6 address as the BGP next hop in cases of route origination or next-hop-self (configured or automatic). It also allows export policies to change the BGP next hop of a VPN IPv4 route to an IPv6 address. All of these cases require the remote peer to advertise the necessary extended NH encoding capability."
        },
        {
            "Parameters": "label-ipv4",
            "Info": "Allows label IPv4 routes to be advertised to IPv6 transport peers with an IPv6 address as the BGP next hop in cases of route origination or next-hop-self (configured or automatic). It also allows export policies to change the BGP next hop of a label IPv4 route to an IPv6 address. All of these cases require the remote peer to advertise the necessary extended NH encoding capability."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no advertise-ipv6-next-hops"
}
{
    "PageTitle": "peer-as",
    "FuncDef": "This command configures the autonomous system number for the remote peer. The peer AS number must be configured for each configured peer.",
    "CLIs": [
        "peer-as <as-number>"
    ],
    "ParentView": [
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "as-number",
            "Info": "Specifies the autonomous system number expressed as a decimal integer. Values-1 to 4294967295."
        }
    ],
    "Examples": null,
    "ExtraInfo": ""
}
{
    "PageTitle": "next-hop-self",
    "FuncDef": "This command configures BGP to advertise routes to members of a group or to a specific neighbor using a local address of the BGP instance as the BGP next-hop address. Note thatnext-hop-selfis set without exception, regardless of the route source (EBGP or IBGP) or its family. When used with VPN-IPv4 and VPN-IPv6 routes theenable-rr-vpn-forwardingcommand should also be configured.",
    "CLIs": [
        "next-hop-self",
        "no next-hop-self"
    ],
    "ParentView": [
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no next-hop-self"
}
{
    "PageTitle": "group",
    "FuncDef": "This command creates a context to configure a BGP peer group.",
    "CLIs": [
        "group <name>",
        "no group <name>"
    ],
    "ParentView": [
        "config>router>bgp"
    ],
    "ParaDef": [
        {
            "Parameters": "name",
            "Info": "Specifies the peer group name. Allowed values are any string up to 32 characters long composed of printable, 7-bit ASCII characters. If the string contains special characters (#, $, spaces, and so on), the entire string must be enclosed within double quotes."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no group"
}
{
    "PageTitle": "ipv6",
    "FuncDef": "This command configures the add-paths capability for unlabeled IPv6 unicast routes. By default, add-paths is not enabled for unlabeled IPv6 unicast routes.",
    "CLIs": [
        "ipv6 send <send-limit> receive [ none ]",
        "ipv6 send <send-limit>",
        "no ipv6"
    ],
    "ParentView": [
        "config>router>bgp>add-paths",
        "config>router>bgp>group>add-paths",
        "config>router>bgp>group>neighbor>add-paths"
    ],
    "ParaDef": [
        {
            "Parameters": "send send-limit",
            "Info": "Specifies the maximum number of paths per unlabeled IPv6 unicast prefix that are allowed to be advertised to add-paths peers. (The actual number of advertised routes may be less.) If the value is none, the router does not negotiate the send capability with respect to IPv6 AFI/SAFI. Values-1 to 16, none."
        },
        {
            "Parameters": "receive",
            "Info": "Specifies the router negotiates to receive multiple unlabeled unicast routes per IPv6 prefix."
        },
        {
            "Parameters": "none",
            "Info": "Specifies the router does not negotiate to receive multiple unlabeled unicast routes per IPv6 prefix."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no ipv6"
}
{
    "PageTitle": "neighbor",
    "FuncDef": "This command creates a BGP peer/neighbor instance within the context of the BGP group.",
    "CLIs": [
        "neighbor <ip-address>",
        "no neighbor <ip-address>"
    ],
    "ParentView": [
        "config>router>bgp>group"
    ],
    "ParaDef": [
        {
            "Parameters": "ip-address",
            "Info": "Specifies the IP address of the BGP peer router in dotted decimal notation. Values-ipv4-address:."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no neighbor"
}
{
    "PageTitle": "router-id",
    "FuncDef": "This command configures the router ID for the router instance.",
    "CLIs": [
        "router-id <router-id>",
        "no router-id"
    ],
    "ParentView": [
        "config>router"
    ],
    "ParaDef": [
        {
            "Parameters": "router-id",
            "Info": "Specifies the 32 bit router ID, expressed in dotted decimal notation or as a decimal value."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no router-id"
}
{
    "PageTitle": "disable-4byte-asn",
    "FuncDef": "This command disables the use of 4-byte ASNs. It can be configured at all 3 level of the hierarchy so it can be specified down to the per peer basis.",
    "CLIs": [
        "disable-4byte-asn",
        "no disable-4byte-asn"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no disable-4byte-asn"
}
{
    "PageTitle": "link-bandwidth",
    "FuncDef": "This command enables the configuration context for handling the link-bandwidth extended community attached to specific BGP routes.",
    "CLIs": [
        "link-bandwidth"
    ],
    "ParentView": [
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": ""
}
{
    "PageTitle": "route-target-list",
    "FuncDef": "This command specifies the route target(s) to be accepted from or advertised to peers. If theroute-target-listis a non-null list, only routes with one or more of the given route targets are accepted from or advertised to peers.",
    "CLIs": [
        "route-target-list <comm-id> [ <comm-id> ]",
        "no route-target-list [ <comm-id> ]"
    ],
    "ParentView": [
        "config>router>bgp"
    ],
    "ParaDef": [
        {
            "Parameters": "comm-id",
            "Info": "Specifies up to 15 route target communities. Values-[target: {ip-address:comm-val | 2byte-asnumber:ext-comm-val | 4byte-asnumber:comm-val}."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no route-target-list"
}
{
    "PageTitle": "preference",
    "FuncDef": "This command configures the route preference for routes learned from the configured peers.",
    "CLIs": [
        "preference <preference>",
        "no preference <preference>"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "preference",
            "Info": "Specifies the route preference expressed as a decimal integer. Values-1 to 255."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: preference 170"
}
{
    "PageTitle": "dynamic-neighbor",
    "FuncDef": "This command enables the context to configure dynamic BGP sessions for a peer group.",
    "CLIs": [
        "dynamic-neighbor"
    ],
    "ParentView": [
        "config>router>bgp>group"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": ""
}
{
    "PageTitle": "label-ipv6",
    "FuncDef": "This command configures the add-paths capability for labeled-unicast IPv6 routes. By default, add-paths is not enabled for labeled-unicast IPv6 routes.",
    "CLIs": [
        "label-ipv6 send <send-limit>",
        "label-ipv6 send <send-limit> receive [ none ]",
        "no label-ipv6"
    ],
    "ParentView": [
        "config>router>bgp>add-paths",
        "config>router>bgp>group>add-paths",
        "config>router>bgp>group>neighbor>add-paths"
    ],
    "ParaDef": [
        {
            "Parameters": "send-limit",
            "Info": "Specifies the maximum number of paths per labeled-unicast IPv6 prefix that are allowed to be advertised to add-paths peers. (The actual number of advertised routes may be less.) If the value is none, the router does not negotiate the send capability with respect to label-IPv6 AFI/SAFI. Values-1 to 16, none."
        },
        {
            "Parameters": "receive",
            "Info": "Specifies that the router negotiates to receive multiple labeled-unicast routes per IPv6 prefix."
        },
        {
            "Parameters": "none",
            "Info": "Specifies that the router does not negotiate to receive multiple labeled-unicast routes per IPv6 prefix."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no label-ipv6"
}
{
    "PageTitle": "outbound-route-filtering",
    "FuncDef": "This command opens the configuration tree for sending or accepting BGP filter lists from peers (outbound route filtering).",
    "CLIs": [
        "outbound-route-filtering",
        "no outbound-route-filtering"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no outbound-route-filtering"
}
{
    "PageTitle": "router-id",
    "FuncDef": "This command specifies the router ID to be used with this BGP instance.",
    "CLIs": [
        "router-id <ip-address>",
        "no router-id"
    ],
    "ParentView": [
        "config>router>bgp"
    ],
    "ParaDef": [
        {
            "Parameters": "ip-address",
            "Info": "Specifies the router ID, expressed as any non-zero value in the range 0.0.0.1 to 255.255.255.255 (or when converted to decimal it can have any value in the range 1-4294967295). It is recommended to use the system IPv4 address."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no router-id"
}
{
    "PageTitle": "bgp",
    "FuncDef": "This command selects BGP tunneling for next-hop resolution and specifies the IPv4 tunnels created by receiving BGP label-unicast IPv4 routes for /32.IPv4 prefixes",
    "CLIs": [
        "bgp",
        "no bgp"
    ],
    "ParentView": [
        "config>router>bgp>next-hop-resolution>shortcut-tunn>family>resolution-filter",
        "config>router>bgp>next-hop-resolution>labeled-routes>transport-tunnel>family>resolution-filter"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": ""
}
{
    "PageTitle": "enable-origin-validation",
    "FuncDef": "When theenable-origin-validationcommand is added to the configuration of a group or neighbor, it causes every inbound IPv4 and/or IPv6 route from that peer to be marked with one of the 3 following origin validation states:",
    "CLIs": [
        "enable-origin-validation [ ipv4 ] [ ipv6 ] [ label-ipv4 ] [ label-ipv6 ]",
        "no enable-origin-validation"
    ],
    "ParentView": [
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "ipv4",
            "Info": "Enables origin validation processing for unlabeled unicast IPv4 routes."
        },
        {
            "Parameters": "ipv6",
            "Info": "Enables origin validation processing for unlabeled unicast IPv6 routes."
        },
        {
            "Parameters": "label-ipv4",
            "Info": "Enables origin validation processing for labeled IPv4 routes."
        },
        {
            "Parameters": "label-ipv6",
            "Info": "Enables origin validation processing for labeled IPv6 routes."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no enable-origin-validation"
}
{
    "PageTitle": "export",
    "FuncDef": "This command specifies route policies that control the handling of outbound routes transmitted to certain peers. Route policies are configured in theconfig>router>policy-optionscontext.",
    "CLIs": [
        "export <plcy-or-long-expr> [ <plcy-or-expr> [ <plcy-or-expr> ] ]",
        "no export [ <plcy-or-long-expr> ]"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "plcy-or-long-expr",
            "Info": "Specifies the route policy name (up to 64 characters) or a policy logical expression (up to 255 characters long). Allowed values are any string up to 255 characters long composed of printable, 7-bit ASCII characters. If the string contains special characters (#, $, spaces, and so on), the entire string must be enclosed within double quotes."
        },
        {
            "Parameters": "plcy-or-expr",
            "Info": "Specifies up to 14 route policy names (up to 64 characters each) or a policy logical expression (up to 64 characters long). Allowed values are any string up to 64 characters long composed of printable, 7-bit ASCII characters. If the string contains special characters (#, $, spaces, and so on), the entire string must be enclosed within double quotes."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no export"
}
{
    "PageTitle": "peer-tracking-policy",
    "FuncDef": "This command specifies the name of a policy statement to use with the BGP peer-tracking function on the BGP sessions where this is enabled. The policy controls which IP routes in RTM are eligible to indicate reachability of IPv4 and IPv6 BGP neighbor addresses. If the longest matching route in RTM for a BGP neighbor address is an IP route that is rejected by the policy, or it is a BGP route accepted by the policy, or if there is no matching route, the neighbor is considered unreachable and BGP tears down the peering session and holds it in the idle state until a valid route is once again available and accepted by the policy.",
    "CLIs": [
        "peer-tracking-policy <policy-name>",
        "no peer-tracking-policy"
    ],
    "ParentView": [
        "config>router>bgp"
    ],
    "ParaDef": [
        {
            "Parameters": "policy-name",
            "Info": "Specifies the route policy name. Allowed values are any string up to 64 characters long composed of printable, 7-bit ASCII characters. If the string contains special characters (#, $, spaces, and so on), the entire string must be enclosed within double quotes. Route policies are configured in the config>router>policy-options context."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no peer-tracking-policy"
}
{
    "PageTitle": "loop-detect",
    "FuncDef": "This command configures how the BGP peer session handles loop detection in the AS path.",
    "CLIs": [
        "loop-detect { drop-peer | discard-route | ignore-loop | off }",
        "no loop-detect"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "drop-peer",
            "Info": "Sends a notification to the remote peer and drops the session."
        },
        {
            "Parameters": "discard-route",
            "Info": "Discards routes received from a peer with the same AS number as the router itself. This option prevents routes looped back to the router from being added to the routing information base and consuming memory. When this option is changed, the change will not be active for an established peer until the connection is re-established for the peer."
        },
        {
            "Parameters": "ignore-loop",
            "Info": "Ignores routes with loops in the AS path but maintains peering."
        },
        {
            "Parameters": "off",
            "Info": "Disables loop detection."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: loop-detect ignore-loop"
}
{
    "PageTitle": "add-to-received-ebgp",
    "FuncDef": "This command configures BGP to automatically add a link-bandwidth extended community to every route received from a directly connected (single-hop) EBGP peer within the scope of the command, as long as that route belongs to one of the listed address families.",
    "CLIs": [
        "add-to-received-ebgp <family> [ <family> ]",
        "no add-to-received-ebgp"
    ],
    "ParentView": [
        "config>router>bgp>group>link-bandwidth",
        "config>router>bgp>group>neighbor>link-bandwidth"
    ],
    "ParaDef": [
        {
            "Parameters": "family",
            "Info": "Specifies the address families for which receiving the link-bandwidth extended community from EBGP peers should be supported. Values-ipv4 - Adds a link-bandwidth extended community to unlabeled unicast IPv4 routes.."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no add-to-received-ebgp"
}
{
    "PageTitle": "authentication-key",
    "FuncDef": "This command configures the BGP authentication key.",
    "CLIs": [
        "authentication-key [ authentication-key | <hash-key> ] [ hash | hash2 ]",
        "no authentication-key"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "authentication-key",
            "Info": "Specifies the authentication key. The key can be any combination of ASCII characters up to 255 characters in length (unencrypted). If spaces are used in the string, enclose the entire string in quotation marks (\" \")."
        },
        {
            "Parameters": "hash-key",
            "Info": "Specifies the hash key. The key can be any combination of ASCII characters up to 342 characters in length (encrypted). If spaces are used in the string, enclose the entire string in quotation marks (\" \")."
        },
        {
            "Parameters": "hash",
            "Info": "Specifies the key is entered in an encrypted form. If the hash or hash2 parameter is not used, the key is assumed to be in an unencrypted, clear text form. For security, all keys are stored in encrypted form in the configuration file with the hash or hash2 parameter specified."
        },
        {
            "Parameters": "hash2",
