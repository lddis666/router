You are an expert assistant in configuring network devices. Based on the user's request and the retrieved content from the router configuration manual below, generate appropriate CLI configuration commands.

---

User Request:  
How to configure a Nokia router to permit BGP next-hop resolution for labeled IPv4/IPv6 and VPN-IPv4/IPv6 routes using static routes (excluding default static routes)?

Retrieved Reference Content (from the configuration manual):  
{
    "PageTitle": "loop-detect",
    "FuncDef": "This command configures how the BGP peer session handles loop detection in the AS path.",
    "CLIs": [
        "loop-detect { drop-peer | discard-route | ignore-loop | off }",
        "no loop-detect"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "drop-peer",
            "Info": "Sends a notification to the remote peer and drops the session."
        },
        {
            "Parameters": "discard-route",
            "Info": "Discards routes received from a peer with the same AS number as the router itself. This option prevents routes looped back to the router from being added to the routing information base and consuming memory. When this option is changed, the change will not be active for an established peer until the connection is re-established for the peer."
        },
        {
            "Parameters": "ignore-loop",
            "Info": "Ignores routes with loops in the AS path but maintains peering."
        },
        {
            "Parameters": "off",
            "Info": "Disables loop detection."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: loop-detect ignore-loop"
}
{
    "PageTitle": "local-as",
    "FuncDef": "This command configures a BGP local autonomous system (AS) number. In addition to the global AS number configured for BGP using the autonomous-system command, a local AS number can be configured to support various AS number migration scenarios.",
    "CLIs": [
        "local-as <as-number> [ private ] [ <no-prepend-global-as> ]",
        "no local-as"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "as-number",
            "Info": "Specifies the virtual autonomous system number expressed as a decimal integer. Values-1 to 4294967295."
        },
        {
            "Parameters": "private",
            "Info": "Specifies the local-as is hidden in paths learned from the peering."
        },
        {
            "Parameters": "no-prepend-global-as",
            "Info": "Specifies that the global-as is hidden in paths announced to the BGP peer."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no local-as"
}
{
    "PageTitle": "import",
    "FuncDef": "This command specifies route policies that control the handling of inbound routes received from certain peers. Route policies are configured in theconfig>router>policy-optionscontext.",
    "CLIs": [
        "import <plcy-or-long-expr> [ <plcy-or-expr> [ <plcy-or-expr> ] ]",
        "no import"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "plcy-or-long-expr",
            "Info": "Specifies the route policy name (up to 64 characters long) or a policy logical expression (up to 255 characters long). Allowed values are any string up to 255 characters long composed of printable, 7-bit ASCII characters. If the string contains special characters (#, $, spaces, and so on), the entire string must be enclosed within double quotes."
        },
        {
            "Parameters": "plcy-or-expr",
            "Info": "Specifies the route policy name (up to 64 characters long) or a policy logical expression (up to 64 characters long). Allowed values are any string up to 64 characters long composed of printable, 7-bit ASCII characters. If the string contains special characters (#, $, spaces, and so on), the entire string must be enclosed within double quotes."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no import"
}
