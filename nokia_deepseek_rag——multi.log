You are an expert assistant in configuring network devices. Based on the user's request and the retrieved content from the router configuration manual below, generate appropriate CLI configuration commands.

---

User Request:  
How to configure Nokia routers to generate a warning message when receiving 5000 IPv6 routes from a BGP peer, with a threshold alert at 80% capacity, without terminating the session?

Retrieved Reference Content (from the configuration manual):  
{
    "PageTitle": "local-as",
    "FuncDef": "This command configures a BGP local autonomous system (AS) number. In addition to the global AS number configured for BGP using the autonomous-system command, a local AS number can be configured to support various AS number migration scenarios.",
    "CLIs": [
        "local-as <as-number> [ private ] [ <no-prepend-global-as> ]",
        "no local-as"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "as-number",
            "Info": "Specifies the virtual autonomous system number expressed as a decimal integer. Values-1 to 4294967295."
        },
        {
            "Parameters": "private",
            "Info": "Specifies the local-as is hidden in paths learned from the peering."
        },
        {
            "Parameters": "no-prepend-global-as",
            "Info": "Specifies that the global-as is hidden in paths announced to the BGP peer."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no local-as"
}
{
    "PageTitle": "aggregator-id-zero",
    "FuncDef": "This command sets the router ID in the BGP aggregator path attribute to zero when BGP aggregates routes. This prevents different routers within an AS from creating aggregate routes that contain different AS paths.",
    "CLIs": [
        "aggregator-id-zero",
        "no aggregator-id-zero"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no aggregator-id-zero"
}
{
    "PageTitle": "prefix-limit",
    "FuncDef": "This command configures the maximum number of BGP routes that can be received from a peer before some administrative action is taken. The administrative action can be the generation of a log event or taking down the session. If a session is taken down, then it can be brought back up automatically after an idle-timeout period, or else it can be configured to stay down ('forever') until the operator performs a reset.",
    "CLIs": [
        "prefix-limit <family> <limit> [ threshold <percentage> ] [ idle-timeout { <minutes> | forever } | log-only ] [ post-import ]",
        "no prefix-limit <family>"
    ],
    "ParentView": [
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "log-only",
            "Info": "Enables the warning message to be sent at the specified threshold percentage, and also when the limit is reached. However, the BGP session is not taken down."
        },
        {
            "Parameters": "percentage",
            "Info": "Specifies the threshold value (as a percentage) that triggers a warning message to be sent. Values-1 to 100."
        },
        {
            "Parameters": "family",
            "Info": "Specifies the address family to which the limit applies. Values-ipv4, label-ipv4, vpn-ipv4, ipv6, label-ipv6, vpn-ipv6, mcast-ipv4, l2-vpn, mvpn-ipv4, mdt-safi, ms-pw, flow-ipv4, route-target, mcast-vpn-ipv4, mvpn-ipv6, flow-ipv6, evpn, mcast-ipv6, bgp-ls."
        },
        {
            "Parameters": "limit",
            "Info": "Specifies the number of routes that can be learned from a peer expressed as a decimal integer. Values-1 to 4294967295."
        },
        {
            "Parameters": "minutes",
            "Info": "Specifies duration in minutes before automatically re-establishing a session. Values-1 to 1024."
        },
        {
            "Parameters": "forever",
            "Info": "Specifies that the session is reestablished only after clear router bgp command is executed."
        },
        {
            "Parameters": "post-import",
            "Info": "Specifies that the limit should be applied only to the number of routes that are accepted by import policies."
        }
    ],
    "Examples": null,
    "ExtraInfo": ""
}
{
    "PageTitle": "primary-ipv6-address",
    "FuncDef": "This command specifies the primary IPv6 address of a reference location used for BGP optimal route reflection. Up to three IPv4 addresses and three IPv6 addresses can be specified per location.",
    "CLIs": [
        "primary-ipv6-address <ipv6-address>",
        "no primary-ipv6-address"
    ],
    "ParentView": [
        "config>router>bgp>orr>location"
    ],
    "ParaDef": [
        {
            "Parameters": "ipv6-address",
            "Info": "Specifies the primary IPv6 address of a location expressed in dotted decimal notation. Values-ipv6-address:."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no primary-ipv6-address"
}
{
    "PageTitle": "passive",
    "FuncDef": "Enables/disables passive mode for the BGP group or neighbor.",
    "CLIs": [
        "passive",
        "no passive"
    ],
    "ParentView": [
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no passive"
}
{
    "PageTitle": "local-address",
    "FuncDef": "This command configures the local IP address used by the group or neighbor when communicating with BGP peers.",
    "CLIs": [
        "local-address [ <ip-int-name> | <ip-address> | <ipv6-address> ]",
        "no local-address"
    ],
    "ParentView": [
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "ip-address",
            "Info": "Specifies the local address expressed in dotted decimal notation. Allowed value is a valid routable IP address on the router, either an interface or system IP address. Values-ipv4-address:."
        },
        {
            "Parameters": "ipv6-address",
            "Info": "Specifies the local address expressed in dotted decimal notation. Allowed value is a valid routable IPv6 address on the router, either an interface or system IPv6 address. Values-ipv6-address:."
        },
        {
            "Parameters": "ip-int-name",
            "Info": "Specifies the IP interface name whose address the local address will inherit. The interface can be any network interface configured on the system."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no local-address"
}
{
    "PageTitle": "as-path-ignore",
    "FuncDef": "This command configures whether AS path length is considered in the selection of the best BGP route for a prefix.",
    "CLIs": [
        "as-path-ignore [ ipv4 ] [ label-ipv4 ] [ vpn-ipv4 ] [ ipv6 ] [ label-ipv6 ] [ vpn-ipv6 ] [ mcast-ipv4 ] [ mcast-ipv6 ] [ mvpn-ipv4 ] [ mvpn-ipv6 ] [ l2-vpn ]",
        "no as-path-ignore"
    ],
    "ParentView": [
        "config>router>bgp>best-path-selection"
    ],
    "ParaDef": [
        {
            "Parameters": "ipv4",
            "Info": "Specifies that the AS-path length will be ignored for all unlabeled unicast IPv4 routes."
        },
        {
            "Parameters": "label-ipv4",
            "Info": "Specifies that the AS-path length will be ignored for all labeled-unicast IPv4 routes."
        },
        {
            "Parameters": "vpn-ipv4",
            "Info": "Specifies that the length AS-path will be ignored for all IPv4 VPRN (SAFI 128) routes."
        },
        {
            "Parameters": "ipv6",
            "Info": "Specifies that the AS-path length will be ignored for all unlabeled unicast IPv6 routes."
        },
        {
            "Parameters": "label-ipv6",
            "Info": "Specifies that the AS-path length will be ignored for all labeled-unicast IPv6 routes."
        },
        {
            "Parameters": "vpn-ipv6",
            "Info": "Specifies that the AS-path length will be ignored for all IPv6 VPRN (SAFI 128) routes."
        },
        {
            "Parameters": "mcast-ipv4",
            "Info": "Specifies that the AS-path length will be ignored for all IPv4 multicast routes."
        },
        {
            "Parameters": "mcast-ipv6",
            "Info": "Specifies that the AS-path length will be ignored for all IPv6 multicast routes."
        },
        {
            "Parameters": "mvpn-ipv4",
            "Info": "Specifies that the AS-path length will be ignored for all IPv4 MVPN routes."
        },
        {
            "Parameters": "mvpn-ipv6",
            "Info": "Specifies that the AS-path length will be ignored for all IPv6 MVPN routes."
        },
        {
            "Parameters": "l2-vpn",
            "Info": "The AS-path length will be ignored for all L2-VPN NLRIs."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no as-path-ignore"
}
