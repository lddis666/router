You are an expert assistant in configuring network devices. Based on the user's request and the retrieved content from the router configuration manual below, generate appropriate CLI configuration commands.

---

User Request:  
How to configure Nokia router's BGP to advertise best external routes for labeled-unicast IPv6 and unlabeled unicast IPv4 simultaneously?

Retrieved Reference Content (from the configuration manual):  
{
    "PageTitle": "local-as",
    "FuncDef": "This command configures a BGP local autonomous system (AS) number. In addition to the global AS number configured for BGP using the autonomous-system command, a local AS number can be configured to support various AS number migration scenarios.",
    "CLIs": [
        "local-as <as-number> [ private ] [ <no-prepend-global-as> ]",
        "no local-as"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "as-number",
            "Info": "Specifies the virtual autonomous system number expressed as a decimal integer. Values-1 to 4294967295."
        },
        {
            "Parameters": "private",
            "Info": "Specifies the local-as is hidden in paths learned from the peering."
        },
        {
            "Parameters": "no-prepend-global-as",
            "Info": "Specifies that the global-as is hidden in paths announced to the BGP peer."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no local-as"
}
{
    "PageTitle": "route-table-import",
    "FuncDef": "This command specifies the name of a route to control the importation of active routes from the IP route table into one of the BGP RIBs.",
    "CLIs": [
        "route-table-import <policy-name>",
        "no route-table-import"
    ],
    "ParentView": [
        "config>router>bgp>rib-management>ipv4",
        "config>router>bgp>rib-management>label-ipv4",
        "config>router>bgp>rib-management>ipv6",
        "config>router>bgp>rib-management>label-ipv6"
    ],
    "ParaDef": [
        {
            "Parameters": "policy-name",
            "Info": "Specifies the name of a policy-statement (up to 64 characters)."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no route-table-import"
}
{
    "PageTitle": "disable-fast-external-failover",
    "FuncDef": "This command configures BGP fast external failover.",
    "CLIs": [
        "disable-fast-external-failover",
        "no disable-fast-external-failover"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no disable-fast-external-failover"
}
{
    "PageTitle": "allow-static",
    "FuncDef": "This command allows the BGP next-hop of label-IPv4, label-IPv6, VPN-IPv4, and VPN-IPv6 routes received from any EBGP or IBGP peer to be resolved using static routes, except for static default routes (0/0 and ::/0).",
    "CLIs": [
        "allow-static",
        "no allow-static"
