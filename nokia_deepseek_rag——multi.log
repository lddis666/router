You are an expert assistant in configuring network devices. Based on the user's request and the retrieved content from the router configuration manual below, generate appropriate CLI configuration commands.

---

User Request:  
How to configure a Nokia router to advertise up to 8 paths per multicast VPN IPv4 prefix and disable receiving multiple routes for the same prefix?

Retrieved Reference Content (from the configuration manual):  
{
    "PageTitle": "enable-inter-as-vpn",
    "FuncDef": "This command specifies whether VPNs can exchange routes across autonomous system boundaries, providing model B connectivity",
    "CLIs": [
        "enable-inter-as-vpn",
        "no enable-inter-as-vpn"
    ],
    "ParentView": [
        "config>router>bgp"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no enable-inter-as-vpn"
}
{
    "PageTitle": "mcast-vpn-ipv4",
    "FuncDef": "This command configures the add-paths capability for multicast IPv4 VPN routes. By default, add-paths is not enabled for multicast IPv4 VPN routes.",
    "CLIs": [
        "mcast-vpn-ipv4 send <send-limit> receive [ none ]",
        "mcast-vpn-ipv4 send <send-limit>",
        "no mcast-vpn-ipv4"
    ],
    "ParentView": [
        "config>router>bgp>add-paths",
        "config>router>bgp>group>add-paths",
        "config>router>bgp>group>neighbor>add-paths"
    ],
    "ParaDef": [
        {
            "Parameters": "send-limit",
            "Info": "Specifies the maximum number of paths per multicast IPv4 VPN prefix that are allowed to be advertised to add-paths peers. The actual number of advertised routes may be less. If the value is none, the router does not negotiate the send capability with respect to multicast IPv4 VPN AFI/SAFI. Values-1 to 16, none."
        },
        {
            "Parameters": "receive",
            "Info": "Specifies that the router negotiates to receive multiple multicast routes per IPv4 VPN prefix."
        },
        {
            "Parameters": "none",
            "Info": "Specifies that the router does not negotiate to receive multiple multicast routes per IPv4 VPN prefix."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no mcast-vpn-ipv4"
}
{
    "PageTitle": "stats-report-interval",
    "FuncDef": "This command configures the frequency of sending statistics reporting messages to the BMP monitoring station",
    "CLIs": [
        "stats-report-interval [ <seconds> ]",
        "no stats-report-interval"
    ],
    "ParentView": [
        "config>bmp>station"
    ],
    "ParaDef": [
        {
            "Parameters": "seconds",
            "Info": "Specifies the frequency of sending statistics reporting messages, in seconds, to the BMP monitoring station. Values-15 to 65535."
        }
    ],
    "Examples": null,
    "ExtraInfo": ""
}
{
