You are an expert assistant in configuring network devices. Based on the user's request and the retrieved content from the router configuration manual below, generate appropriate CLI configuration commands.

---

User Request:  
How to configure a Nokia router to advertise up to 3 different paths per multicast VPN IPv6 prefix and disable receiving multiple paths from peers?

Retrieved Reference Content (from the configuration manual):  
{
    "PageTitle": "ignore-router-id",
    "FuncDef": "When theignore-router-idcommand is present, and the current best path to a destination was learned from EBGP peer X with BGP identifier x and a new path is received from EBGP peer Y with BGP identifier y, the best path remains unchanged if the new path is equivalent to the current best path up to the BGP identifier comparison - even if y is less than x.",
    "CLIs": [
        "ignore-router-id include-internal <family> [ <family> ]",
        "[ no ] ignore-router-id"
    ],
    "ParentView": [
        "config>router>bgp>best-path-selection",
        "config>service>vprn>bgp>best-path-selection"
    ],
    "ParaDef": [
        {
            "Parameters": "family",
            "Info": "Specifies up to two internal families to be included in this configuration. Values-mvpn-ipv4, mvpn-ipv6."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no ignore-router-id"
}
{
    "PageTitle": "import",
    "FuncDef": "This command specifies route policies that control the handling of inbound routes received from certain peers. Route policies are configured in theconfig>router>policy-optionscontext.",
    "CLIs": [
        "import <plcy-or-long-expr> [ <plcy-or-expr> [ <plcy-or-expr> ] ]",
        "no import"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "plcy-or-long-expr",
            "Info": "Specifies the route policy name (up to 64 characters long) or a policy logical expression (up to 255 characters long). Allowed values are any string up to 255 characters long composed of printable, 7-bit ASCII characters. If the string contains special characters (#, $, spaces, and so on), the entire string must be enclosed within double quotes."
        },
        {
            "Parameters": "plcy-or-expr",
            "Info": "Specifies the route policy name (up to 64 characters long) or a policy logical expression (up to 64 characters long). Allowed values are any string up to 64 characters long composed of printable, 7-bit ASCII characters. If the string contains special characters (#, $, spaces, and so on), the entire string must be enclosed within double quotes."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no import"
}
{
    "PageTitle": "enable-inter-as-vpn",
    "FuncDef": "This command specifies whether VPNs can exchange routes across autonomous system boundaries, providing model B connectivity",
    "CLIs": [
        "enable-inter-as-vpn",
        "no enable-inter-as-vpn"
    ],
    "ParentView": [
        "config>router>bgp"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no enable-inter-as-vpn"
}
{
    "PageTitle": "prefix-limit",
    "FuncDef": "This command configures the maximum number of BGP routes that can be received from a peer before some administrative action is taken. The administrative action can be the generation of a log event or taking down the session. If a session is taken down, then it can be brought back up automatically after an idle-timeout period, or else it can be configured to stay down ('forever') until the operator performs a reset.",
    "CLIs": [
        "prefix-limit <family> <limit> [ threshold <percentage> ] [ idle-timeout { <minutes> | forever } | log-only ] [ post-import ]",
        "no prefix-limit <family>"
    ],
    "ParentView": [
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "log-only",
            "Info": "Enables the warning message to be sent at the specified threshold percentage, and also when the limit is reached. However, the BGP session is not taken down."
        },
        {
            "Parameters": "percentage",
            "Info": "Specifies the threshold value (as a percentage) that triggers a warning message to be sent. Values-1 to 100."
        },
        {
            "Parameters": "family",
            "Info": "Specifies the address family to which the limit applies. Values-ipv4, label-ipv4, vpn-ipv4, ipv6, label-ipv6, vpn-ipv6, mcast-ipv4, l2-vpn, mvpn-ipv4, mdt-safi, ms-pw, flow-ipv4, route-target, mcast-vpn-ipv4, mvpn-ipv6, flow-ipv6, evpn, mcast-ipv6, bgp-ls."
        },
        {
            "Parameters": "limit",
            "Info": "Specifies the number of routes that can be learned from a peer expressed as a decimal integer. Values-1 to 4294967295."
        },
        {
            "Parameters": "minutes",
            "Info": "Specifies duration in minutes before automatically re-establishing a session. Values-1 to 1024."
        },
        {
            "Parameters": "forever",
            "Info": "Specifies that the session is reestablished only after clear router bgp command is executed."
        },
        {
            "Parameters": "post-import",
            "Info": "Specifies that the limit should be applied only to the number of routes that are accepted by import policies."
        }
    ],
    "Examples": null,
    "ExtraInfo": ""
}
