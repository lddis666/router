{
    "FuncDef": "Configures BGP IPv6 peer advertisement interval to control the rate at which BGP updates (including Link-State information) are sent to a specified neighbor, preventing excessive update flooding while maintaining synchronization.",
    "CLIs": [
        "peer 2001:db8:2::2 advertisement-interval 20"
    ],
    "ParaDef": [
        {
            "Parameters": "2001:db8:2::2",
            "Info": "Specifies the IPv6 address of the BGP neighbor to which the advertisement interval applies."
        },
        {
            "Parameters": "advertisement-interval 20",
            "Info": "Sets the minimum interval (in seconds) between sending BGP routing updates to the peer. Value range: 0-600 seconds. A value of 20 ensures updates are throttled to once every 20 seconds even for identical prefix advertisements."
        }
    ]
}
```
