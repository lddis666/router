```json
{
    "FuncDef": "Configures BGP route reflection for an IPv6 peer group, enabling the router to reflect received routes unchanged between all members of the specified group. This creates a 'passthrough' behavior where the NE40E acts as a route reflector without modifying attributes.",
    "CLIs": [
        "peer internet_peers reflect-client"
    ],
    "ParaDef": [
        {
            "Parameters": "internet_peers",
            "Info": "Name of the BGP peer group configured for external providers. Must match the existing peer group name."
        },
        {
            "Parameters": "reflect-client",
            "Info": "Enables route reflection for the specified peer group. The router becomes a route reflector, reflecting routes between clients in the group without altering path attributes like AS_PATH."
