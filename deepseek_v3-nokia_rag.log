    "FuncDef": "Configures conditional advertisement of a default route (0.0.0.0/0) to BGP peers in a specified group, triggered by the presence of either IPv6 prefix 2001:db8::/32 or 2001:db8:abcd::/48 in the routing table.",
    "CLIs": [
        "peer INTERNAL_PEERS advertise conditional-route all advertise-route 0.0.0.0 0 match-route 2001:db8:: 32 OR 2001:db8:abcd:: 48"
    ],
    "ParaDef": [
        {
            "Parameters": "INTERNAL_PEERS",
            "Info": "Name of the BGP peer group to which the conditional advertisement policy applies."
        },
