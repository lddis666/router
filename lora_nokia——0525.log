input_text
You are an expert assistant in configuring network devices. Based on the user's request and the retrieved content from the router configuration manual below, generate appropriate CLI configuration commands.

---

User Request:  
How to configure Nokia routers to set the F bit to 1 for non-forwarding AFI/SAFI families during BGP graceful restart?

Retrieved Reference Content (from the configuration manual):  
{
    "PageTitle": "local-preference",
    "FuncDef": "This command enables setting the BGP local-preference attribute in incoming routes if not specified and configures the default value for the attribute.",
    "CLIs": [
        "local-preference <local-preference>",
        "no local-preference"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "local-preference",
            "Info": "Specifies the local preference value to be used as the override value expressed as a decimal integer. Values-0 to 4294967295."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no local-preference"
}
{
    "PageTitle": "mvpn-ipv4",
    "FuncDef": "This command configures the add-paths capability for multicast VPN IPv4 routes. By default, add-paths is not enabled for multicast VPN IPv4 routes.",
    "CLIs": [
        "mvpn-ipv4 send <send-limit> receive [ none ]",
        "mvpn-ipv4 send <send-limit>",
        "no mvpn-ipv4"
    ],
    "ParentView": [
        "config>router>bgp>add-paths",
        "config>router>bgp>group>add-paths",
        "config>router>bgp>group>neighbor>add-paths"
    ],
    "ParaDef": [
        {
            "Parameters": "send-limit",
            "Info": "Specifies the maximum number of paths per multicast VPN IPv4 prefix that are allowed to be advertised to add-paths peers. The actual number of advertised routes may be less. If the value is none, the router does not negotiate the send capability with respect to multicast VPN IPv4 AFI/SAFI. ParamDefault: Default- 1 to 16, none"
        },
        {
            "Parameters": "receive",
            "Info": "Specifies that the router negotiates to receive multiple multicast VPN routes per IPv4 prefix."
        },
        {
            "Parameters": "none",
            "Info": "Specifies that the router does not negotiate to receive multiple multicast VPN routes per IPv4 prefix."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no mvpn-ipv4"
}
{
    "PageTitle": "rapid-update",
    "FuncDef": "This command enables and disables BGP rapid update for specified address families.",
    "CLIs": [
        "rapid-update [ l2-vpn ] [ mvpn-ipv4 ] [ mvpn-ipv6 ] [ mdt-safi ] [ evpn ] [ label-ipv4 ] [ label-ipv6 ] [ vpn-ipv4 ] [ vpn-ipv6 ] [ mcast-vpn-ipv4 ] [ mcast-vpn-ipv6 ]",
        "no rapid-update"
    ],
    "ParentView": [
        "config>router>bgp"
    ],
    "ParaDef": [
        {
            "Parameters": "l2-vpn",
            "Info": "Specifies the BGP rapid update for the 12-byte Virtual Switch Instance identifier (VSI-ID) value consisting of the 8-byte route distinguisher (RD) followed by a 4-byte value."
        },
        {
            "Parameters": "mvpn-ipv4",
            "Info": "Specifies BGP rapid update for the mvpn-ipv4 address family. The mvpn-pv4 address is a variable size value consisting of the 1-byte route type, 1-byte length and variable size that is route type specific. Route type defines encoding for the route type specific field. Length indicates the length in octets of the route type specific field."
        },
        {
            "Parameters": "mdt-safi",
