    ],
    "ParaDef": [
        {
            "Parameters": "seconds",
            "Info": "Specifies the locally imposed LLGR stale time in seconds. Values-0 to 16777215."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no helper-override-stale-time"
}


