```cli
configure router
    bgp
        group "LEGACY"
            family ipv4
            type external
            neighbor 192.0.2.1
                peer-as <LEGACY_DEVICE_AS_NUM>
                no graceful-restart
                no extended-nh-encoding
                no third-party-nexthop
            exit
        exit
    exit
