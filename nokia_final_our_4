    community "no-rtm" members "target:64500:100"
    policy-statement "mark-external"
        entry 10
            from
                protocol bgp
            action accept
                community add "no-rtm"
            exit
        exit
    policy-statement "block-rtm-import"
        entry 10
            from community "no-rtm"
            action reject
            exit
        exit
    exit
commit
exit

/configure router bgp
    import "mark-external"
    rib-management
        ipv4
            route-table-import "block-rtm-import"
        exit
        ipv6
            route-table-import "block-rtm-import"
        exit
    exit
exit
```

