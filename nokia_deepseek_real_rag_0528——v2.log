Here's the proper CLI configuration sequence to implement your requirements:

```
configure router
    policy-options
        begin
        # Define your cust123-inbound policy here first
        commit
    exit
    bgp
        group "customer-123-group"
            neighbor <customer_IP_address>
                import ["cust123-inbound" "additional-filtering-policy"]
                enforce-first-as
                prefix-limit ipv4 500000 threshold 75 idle-timeout 15 post-import
        exit
    exit
exit
```

