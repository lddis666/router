        group "TRANSIT_PROVIDERS" type external
            import "TRANSIT_IMPORT_POLICY"
            export "TRANSIT_EXPORT_POLICY"
            peer-as <transit_AS1>
            neighbor <transit_IP1>
                family ipv4
            exit
            peer-as <transit_AS2>
            neighbor <transit_IP2>
                family ipv4
            exit
        exit
    exit
exit
