        exit
        policy-options
            begin
            policy-statement "BLOCK_DEFAULT"
                entry 10
                    from route-filter 0.0.0.0/0 exact
                    action drop
                    exit
                exit
                entry 20
                    from
                    action accept
                    exit
                exit
            exit
            policy-statement "ALLOW_DEFAULT"
                entry 10
                    from
                    action accept
                    exit
                exit
            exit
            commit
        exit
        group "SELECTIVE_PEERS"
            export "ALLOW_DEFAULT"
            neighbor <IP_PEER_1>
            exit
        exit
        group "OTHER_PEERS"
            export "BLOCK_DEFAULT"
            neighbor <IP_PEER_2>
            neighbor <IP_PEER_3>
            exit
        exit
    exit
```

