 peer VPN_GROUP as-number 65001           # Create peer group (if new)
 peer 2001:DB8:2::2 group VPN_GROUP       # Assign peer to the group
 #
 ipv6-family unicast
  peer VPN_GROUP enable                   # Enable group for IPv6
#
```

