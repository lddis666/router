```bash
bgp 65001  # Local AS number (e.g., 65001)
 peer 192.168.5.3 as-number 65002  # Peer IP and AS number (e.g., 65002)
 #
 ipv4-family vpn-instance VPN_CUSTOMER
  peer 192.168.5.3 enable  # Enable BGP for the peer in VPN instance
  peer 192.168.5.3 ebgp-max-hop 15  # Allow 15 hops (required for multi-hop EBGP)
  peer 192.168.5.3 connect-interface LoopBack1  # Source from LoopBack1
```

---

