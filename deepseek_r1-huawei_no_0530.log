  route-policy inbound-filter deny node 20
  bgp 65000
    peer 192.168.5.9 as-number 65001 
    ipv4-family vpnv4
      peer 192.168.5.9 enable
      peer 192.168.5.9 route-policy inbound-filter import
    commit
```

