You are an expert assistant in configuring network devices. Based on the user's request and the retrieved content from the router configuration manual below, generate appropriate CLI configuration commands.

---

User Request:  
How to configure TCP authentication with keychain "BGP_secure123" for BGP sessions on Nokia routers?

Retrieved Reference Content (from the configuration manual):  
{
    "PageTitle": "enable-notification",
    "FuncDef": "When this command is present, the graceful restart capability sent by this router indicates support for NOTIFICATION messages. If the peer also supports this capability then the session can be restarted gracefully (while preserving forwarding) if either peer needs to sends a NOTIFICATION message due to some type of event or error.",
    "CLIs": [
        "enable-notification",
        "no enable-notification"
    ],
    "ParentView": [
        "config>router>bgp>graceful-restart",
        "config>router>bgp>group>graceful-restart",
        "config>router>bgp>group>neighbor>graceful-restart"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no enable-notification"
}
{
    "PageTitle": "authentication-key",
    "FuncDef": "This command configures the BGP authentication key.",
    "CLIs": [
        "authentication-key [ authentication-key | <hash-key> ] [ hash | hash2 ]",
        "no authentication-key"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "authentication-key",
            "Info": "Specifies the authentication key. The key can be any combination of ASCII characters up to 255 characters in length (unencrypted). If spaces are used in the string, enclose the entire string in quotation marks (\" \")."
        },
        {
            "Parameters": "hash-key",
            "Info": "Specifies the hash key. The key can be any combination of ASCII characters up to 342 characters in length (encrypted). If spaces are used in the string, enclose the entire string in quotation marks (\" \")."
        },
        {
            "Parameters": "hash",
            "Info": "Specifies the key is entered in an encrypted form. If the hash or hash2 parameter is not used, the key is assumed to be in an unencrypted, clear text form. For security, all keys are stored in encrypted form in the configuration file with the hash or hash2 parameter specified."
        },
        {
            "Parameters": "hash2",
            "Info": "Specifies the key is entered in a more complex encrypted form that involves more variables than the key value alone, meaning that the hash2 encrypted variable cannot be copied and pasted. If the hash or hash2 parameter is not used, the key is assumed to be in an unencrypted, clear text form. For security, all keys are stored in encrypted form in the configuration file with the hash or hash2 parameter specified."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no authentication-key"
}
{
    "PageTitle": "aigp",
    "FuncDef": "This command enables or disables Accumulated IGP (AIGP) path attribute support with one or more BGP peers. BGP path selection among routes with an associated AIGP metric is based on the end-to-end IGP metrics of the different BGP paths, even when these BGP paths span more than one AS and IGP instance.",
    "CLIs": [
        "aigp",
        "no aigp"
    ],
    "ParentView": [
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no aigp"
}
{
    "PageTitle": "auth-keychain",
    "FuncDef": "This command configures a TCP authentication keychain to use for the session. The keychain allows the rollover of authentication keys during the lifetime of a session.",
    "CLIs": [
        "auth-keychain <name>"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "name",
            "Info": "Specifies the name of the keychain, up to 32 characters, to use for the specified TCP session or sessions."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no auth-keychain"
}
{
    "PageTitle": "prefix-limit",
    "FuncDef": "This command configures the maximum number of BGP routes that can be received from a peer before some administrative action is taken. The administrative action can be the generation of a log event or taking down the session. If a session is taken down, then it can be brought back up automatically after an idle-timeout period, or else it can be configured to stay down ('forever') until the operator performs a reset.",
    "CLIs": [
        "prefix-limit <family> <limit> [ threshold <percentage> ] [ idle-timeout { <minutes> | forever } | log-only ] [ post-import ]",
        "no prefix-limit <family>"
    ],
    "ParentView": [
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "log-only",
            "Info": "Enables the warning message to be sent at the specified threshold percentage, and also when the limit is reached. However, the BGP session is not taken down."
        },
        {
            "Parameters": "percentage",
            "Info": "Specifies the threshold value (as a percentage) that triggers a warning message to be sent. Values-1 to 100."
        },
        {
            "Parameters": "family",
            "Info": "Specifies the address family to which the limit applies. Values-ipv4, label-ipv4, vpn-ipv4, ipv6, label-ipv6, vpn-ipv6, mcast-ipv4, l2-vpn, mvpn-ipv4, mdt-safi, ms-pw, flow-ipv4, route-target, mcast-vpn-ipv4, mvpn-ipv6, flow-ipv6, evpn, mcast-ipv6, bgp-ls."
        },
        {
            "Parameters": "limit",
            "Info": "Specifies the number of routes that can be learned from a peer expressed as a decimal integer. Values-1 to 4294967295."
        },
        {
            "Parameters": "minutes",
            "Info": "Specifies duration in minutes before automatically re-establishing a session. Values-1 to 1024."
        },
        {
            "Parameters": "forever",
            "Info": "Specifies that the session is reestablished only after clear router bgp command is executed."
        },
        {
            "Parameters": "post-import",
            "Info": "Specifies that the limit should be applied only to the number of routes that are accepted by import policies."
        }
    ],
    "Examples": null,
    "ExtraInfo": ""
}
{
    "PageTitle": "extended-nh-encoding",
    "FuncDef": "This command configures BGP to advertise (at session OPEN) the capability to receive label IPv4, VPN IPv4 routes, or IPv6 next hops from the peers. These peers should not send such routes unless they receive notification of this capability. If the SR OS router receives a label IPv4 or VPN IPv4 route from a peer to which it did not advertise the necessary capability, the UPDATE message will be considered malformed and this will cause either session reset ortreat-as-withdrawbehavior depending on the error handling settings.",
    "CLIs": [
        "extended-nh-encoding [ label-ipv4 ] [ vpn-ipv4 ]",
        "no extended-nh-encoding"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "label-ipv4",
            "Info": "Instructs BGP to advertise an extended NH encoding capability for NLRI AFI=1, NLRI SAFI=4, and next-hop AFI=2."
        },
        {
            "Parameters": "vpn-ipv4",
            "Info": "Instructs BGP to advertise an extended NH encoding capability for NLRI AFI=1, NLRI SAFI=128, and next-hop AFI=2."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no extended-nh-encoding"
}
{
    "PageTitle": "router-id",
    "FuncDef": "This command specifies the router ID to be used with this BGP instance.",
    "CLIs": [
        "router-id <ip-address>",
        "no router-id"
    ],
    "ParentView": [
        "config>router>bgp"
    ],
    "ParaDef": [
        {
            "Parameters": "ip-address",
            "Info": "Specifies the router ID, expressed as any non-zero value in the range 0.0.0.1 to 255.255.255.255 (or when converted to decimal it can have any value in the range 1-4294967295). It is recommended to use the system IPv4 address."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no router-id"
}
{
    "PageTitle": "damp-peer-oscillations",
    "FuncDef": "This command controls how long a BGP peer session remains in the idle-state after some type of error causes the session to reset. In the idle state, BGP does not initiate or respond to attempts to establish a new session. Repeated errors that occur a short while after each session reset cause longer and longer hold times in the idle state. This command supports the DampPeerOscillations FSM behavior described in section 8.1 of RFC 4271,A Border Gateway Protocol 4 (BGP-4).",
    "CLIs": [
        "damp-peer-oscillations [ idle-hold-time <initial-wait> <second-wait> <max-wait> ] [ error-interval <minutes> ]"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "initial-wait",
            "Info": "The amount of time, in minutes, that a session remains in the idle-state after it has been stable for a while. Values-0 to 2048. ParamDefault: Default- 0"
        },
        {
            "Parameters": "second-wait",
            "Info": "A period of time, in minutes, that is doubled after each repeated session failure that occurs within a relatively short span of time. Values-1 to 2048. ParamDefault: Default- 5"
        },
        {
            "Parameters": "max-wait",
            "Info": "The maximum amount of time, in minutes, that a session remains in the idle-state after it has experienced repeated instability. Values-1 to 2048. ParamDefault: Default- 60"
        },
        {
            "Parameters": "minutes",
            "Info": "The interval of time, in minutes after a session reset, during which the session must be error-free in order to reset the penalty counter and return to idle-hold-time to initial-wait. Values-0 to 2048. ParamDefault: Default- 30"
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no damp-peer-oscillations"
}
