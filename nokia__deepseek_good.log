You are an expert assistant in configuring network devices. Based on the user's request and the retrieved content from the router configuration manual below, generate appropriate CLI configuration commands.

---

User Request:  
How to enable BGP on a Nokia router to advertise locally configured segment routing policies as originated routes to BGP peers supporting the SR policy IPv4 address family?

Retrieved Reference Content (from the configuration manual):  
{
    "PageTitle": "aigp",
    "FuncDef": "This command enables or disables Accumulated IGP (AIGP) path attribute support with one or more BGP peers. BGP path selection among routes with an associated AIGP metric is based on the end-to-end IGP metrics of the different BGP paths, even when these BGP paths span more than one AS and IGP instance.",
    "CLIs": [
        "aigp",
        "no aigp"
    ],
    "ParentView": [
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no aigp"
}
{
    "PageTitle": "primary-ip-address",
    "FuncDef": "This command specifies the primary IP address of a reference location used for BGP optimal route reflection. Up to three IPv4 addresses and three IPv6 addresses can be specified per location.",
    "CLIs": [
        "primary-ip-address <ipv4-address>",
        "no primary-ip-address"
    ],
    "ParentView": [
        "config>router>bgp>orr>location"
    ],
    "ParaDef": [
        {
            "Parameters": "ipv4-address",
            "Info": "Specifies the primary IPv4 address of a location expressed in dotted decimal notation. Values-a.b.c.d."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no primary-ip-address"
}
{
    "PageTitle": "router-id",
    "FuncDef": "This command specifies the router ID to be used with this BGP instance.",
    "CLIs": [
        "router-id <ip-address>",
        "no router-id"
    ],
    "ParentView": [
        "config>router>bgp"
    ],
    "ParaDef": [
        {
            "Parameters": "ip-address",
            "Info": "Specifies the router ID, expressed as any non-zero value in the range 0.0.0.1 to 255.255.255.255 (or when converted to decimal it can have any value in the range 1-4294967295). It is recommended to use the system IPv4 address."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no router-id"
}
{
    "PageTitle": "graceful-restart",
    "FuncDef": "This command enables BGP graceful restart helper procedures (the \"receiving router\" role defined in the standard) for address families included in the GR capabilities of both peers. SR OS can support GR helper functionality for IPv4, IPv6, VPN-IPv4, VPN-IPv6, Label-IPv4, Label-IPv6, L2-VPN, Route-Target (RTC), Flow-IPv4 (IPv4 flow-spec) and Flow-IPv6 (IPv6 flow-spec) routes.",
    "CLIs": [
        "graceful-restart",
        "no graceful-restart"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no graceful-restart"
}
{
    "PageTitle": "enable-peer-tracking",
    "FuncDef": "This command enables BGP peer tracking. BGP peer tracking allows a BGP peer to be dropped immediately if the route used to resolve the BGP peer address is removed from the IP routing table and there is no alternative available. The BGP peer will not wait for the holdtimer to expire; therefore, the BGP re-convergence process is accelerated.",
    "CLIs": [
        "enable-peer-tracking",
        "no enable-peer-tracking"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no enable-peer-tracking"
}
{
    "PageTitle": "ebgp-ibgp-equal",
    "FuncDef": "This command instructs the BGP decision process to ignore the difference between EBGP and IBGP routes in selecting the best path and eligible multipaths (if multipath and ECMP are enabled). The result is a form of EIBGP load-balancing in a multipath scenario.",
    "CLIs": [
        "ebgp-ibgp-equal [ ipv4 ] [ ipv6 ] [ label-ipv4 ] [ label-ipv6 ] [ vpn-ipv4 ] [ vpn-ipv6 ]",
        "no ebgp-ibgp-equal"
    ],
    "ParentView": [
        "config>router>bgp>best-path-selection"
    ],
    "ParaDef": [
        {
            "Parameters": "ipv4",
            "Info": "Specifies that the command should be applied to unlabeled unicast IPv4 routes."
        },
        {
            "Parameters": "ipv6",
            "Info": "Specifies that the command should be applied to unlabeled unicast IPv6 routes."
        },
        {
            "Parameters": "label-ipv4",
            "Info": "Specifies that the command should be applied to labeled unicast IPv4 routes."
        },
        {
            "Parameters": "label-ipv6",
            "Info": "Specifies that the command should be applied to labeled unicast IPv6 routes."
        },
        {
            "Parameters": "vpn-ipv4",
            "Info": "Specifies that the command should be applied to IPv4 VPN routes."
        },
        {
            "Parameters": "vpn-ipv6",
            "Info": "Specifies that the command should be applied to IPv6 VPN routes."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no ebgp-ibgp-equal"
}
{
    "PageTitle": "label-ipv6",
    "FuncDef": "This command configures the add-paths capability for labeled-unicast IPv6 routes. By default, add-paths is not enabled for labeled-unicast IPv6 routes.",
    "CLIs": [
        "label-ipv6 send <send-limit>",
        "label-ipv6 send <send-limit> receive [ none ]",
        "no label-ipv6"
    ],
    "ParentView": [
        "config>router>bgp>add-paths",
        "config>router>bgp>group>add-paths",
        "config>router>bgp>group>neighbor>add-paths"
    ],
    "ParaDef": [
        {
            "Parameters": "send-limit",
            "Info": "Specifies the maximum number of paths per labeled-unicast IPv6 prefix that are allowed to be advertised to add-paths peers. (The actual number of advertised routes may be less.) If the value is none, the router does not negotiate the send capability with respect to label-IPv6 AFI/SAFI. Values-1 to 16, none."
        },
        {
            "Parameters": "receive",
            "Info": "Specifies that the router negotiates to receive multiple labeled-unicast routes per IPv6 prefix."
        },
        {
            "Parameters": "none",
            "Info": "Specifies that the router does not negotiate to receive multiple labeled-unicast routes per IPv6 prefix."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no label-ipv6"
}
{
    "PageTitle": "local-as",
    "FuncDef": "This command configures a BGP local autonomous system (AS) number. In addition to the global AS number configured for BGP using the autonomous-system command, a local AS number can be configured to support various AS number migration scenarios.",
    "CLIs": [
        "local-as <as-number> [ private ] [ <no-prepend-global-as> ]",
        "no local-as"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "as-number",
            "Info": "Specifies the virtual autonomous system number expressed as a decimal integer. Values-1 to 4294967295."
        },
        {
            "Parameters": "private",
            "Info": "Specifies the local-as is hidden in paths learned from the peering."
        },
        {
            "Parameters": "no-prepend-global-as",
            "Info": "Specifies that the global-as is hidden in paths announced to the BGP peer."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no local-as"
}
{
    "PageTitle": "ipv6",
    "FuncDef": "This command configures the add-paths capability for unlabeled IPv6 unicast routes. By default, add-paths is not enabled for unlabeled IPv6 unicast routes.",
    "CLIs": [
        "ipv6 send <send-limit> receive [ none ]",
        "ipv6 send <send-limit>",
        "no ipv6"
    ],
    "ParentView": [
        "config>router>bgp>add-paths",
        "config>router>bgp>group>add-paths",
        "config>router>bgp>group>neighbor>add-paths"
    ],
    "ParaDef": [
        {
            "Parameters": "send send-limit",
            "Info": "Specifies the maximum number of paths per unlabeled IPv6 unicast prefix that are allowed to be advertised to add-paths peers. (The actual number of advertised routes may be less.) If the value is none, the router does not negotiate the send capability with respect to IPv6 AFI/SAFI. Values-1 to 16, none."
        },
        {
            "Parameters": "receive",
            "Info": "Specifies the router negotiates to receive multiple unlabeled unicast routes per IPv6 prefix."
        },
        {
            "Parameters": "none",
            "Info": "Specifies the router does not negotiate to receive multiple unlabeled unicast routes per IPv6 prefix."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no ipv6"
}
{
    "PageTitle": "prefix",
    "FuncDef": "This command configures a prefix from which to accept dynamic BGP sessions; particularly, sessions from source IP addresses not matching any configured neighbor addresses. A dynamic session is associated with the group having the longest match prefix entry for the source IP address of the peer. The group association determines local parameters that apply to the session, including the local AS, the local IP address, the peer AS, the MP-BGP families, the import and export policies, and so on.",
    "CLIs": [
        "prefix <ip-prefix/prefix-length>",
