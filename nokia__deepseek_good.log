You are an expert assistant in configuring network devices. Based on the user's request and the retrieved content from the router configuration manual below, generate appropriate CLI configuration commands.

---

User Request:  
How to configure Nokia routers to allow BGP to use Segment Routing tunnels from the lowest preference OSPF instance for next-hop resolution?

Retrieved Reference Content (from the configuration manual):  
{
    "PageTitle": "advertise-stale-to-all-neighbors",
    "FuncDef": "This command allows BGP routes marked as LLGR stale to be advertised to BGP peers that did not advertise the LLGR capability when the session was opened. Thenoversion of this command causes advertisement behavior to follow the rule that stale routes cannot be advertised to a peer that does not understand or implement the LLGR capability. Stale routes are withdrawn towards such peers.",
    "CLIs": [
        "advertise-stale-to-all-neighbors [ without-no-export | no without-no-export ]",
        "no advertise-stale-to-all-neighbors"
    ],
    "ParentView": [
        "config>router>bgp>graceful-restart>long-lived",
        "config>router>bgp>group>graceful-restart>long-lived",
        "config>router>bgp>group>neighbor>graceful-restart>long-lived"
    ],
    "ParaDef": [
        {
            "Parameters": "without-no-export",
            "Info": "Allows LLGR stale routes to be advertised to all peers, such that they can exit the local AS."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no advertise-stale-to-all-neighbors"
}
{
    "PageTitle": "leak-import",
    "FuncDef": "This command is used to specify route policies that control the importation of leak-eligible routes from the BGP RIB of another routing instance into the unlabeled-IPv4, unlabeled-IPv6, or labeled-IPv4 RIB of the base router. To leak a route from one routing instance to another, the origin and destination RIB types must be the same; for example, it is not possible to leak a route from an unlabeled-IPv4 RIB of a VPRN into the labeled-IPv4 RIB of the base router.",
    "CLIs": [
        "leak-import <plcy-or-long-expr> [ <plcy-or-expr> ]",
        "no leak-import"
    ],
    "ParentView": [
        "config>router>bgp>rib-management>ipv4",
        "config>router>bgp>rib-management>label-ipv4",
        "config>router>bgp>rib-management>ipv6"
    ],
    "ParaDef": [
        {
            "Parameters": "plcy-or-long-expr",
            "Info": "Specifies up to 14 route policy names (up to 64 characters long) or a policy logical expression (up to 255 characters long). Allowed values are any string up to 255 characters long composed of printable, 7-bit ASCII characters. If the string contains special characters (#, $, spaces, and so on), the entire string must be enclosed within double quotes."
        },
        {
            "Parameters": "plcy-or-expr",
            "Info": "The route policy name (up to 64 characters long) or a policy logical expression (up to 64 characters long). Allowed values are any string up to 64 characters long composed of printable, 7-bit ASCII characters. If the string contains special characters (#, $, spaces, and so on), the entire string must be enclosed within double quotes."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no leak-import"
}
{
    "PageTitle": "enable-peer-tracking",
    "FuncDef": "This command enables BGP peer tracking. BGP peer tracking allows a BGP peer to be dropped immediately if the route used to resolve the BGP peer address is removed from the IP routing table and there is no alternative available. The BGP peer will not wait for the holdtimer to expire; therefore, the BGP re-convergence process is accelerated.",
    "CLIs": [
        "enable-peer-tracking",
        "no enable-peer-tracking"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no enable-peer-tracking"
}
{
    "PageTitle": "ebgp-ibgp-equal",
    "FuncDef": "This command instructs the BGP decision process to ignore the difference between EBGP and IBGP routes in selecting the best path and eligible multipaths (if multipath and ECMP are enabled). The result is a form of EIBGP load-balancing in a multipath scenario.",
    "CLIs": [
        "ebgp-ibgp-equal [ ipv4 ] [ ipv6 ] [ label-ipv4 ] [ label-ipv6 ] [ vpn-ipv4 ] [ vpn-ipv6 ]",
        "no ebgp-ibgp-equal"
    ],
    "ParentView": [
        "config>router>bgp>best-path-selection"
    ],
    "ParaDef": [
        {
            "Parameters": "ipv4",
            "Info": "Specifies that the command should be applied to unlabeled unicast IPv4 routes."
        },
        {
            "Parameters": "ipv6",
            "Info": "Specifies that the command should be applied to unlabeled unicast IPv6 routes."
        },
        {
            "Parameters": "label-ipv4",
            "Info": "Specifies that the command should be applied to labeled unicast IPv4 routes."
        },
        {
            "Parameters": "label-ipv6",
            "Info": "Specifies that the command should be applied to labeled unicast IPv6 routes."
        },
        {
            "Parameters": "vpn-ipv4",
            "Info": "Specifies that the command should be applied to IPv4 VPN routes."
        },
        {
            "Parameters": "vpn-ipv6",
            "Info": "Specifies that the command should be applied to IPv6 VPN routes."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no ebgp-ibgp-equal"
}
{
    "PageTitle": "label-ipv6",
    "FuncDef": "This command configures the add-paths capability for labeled-unicast IPv6 routes. By default, add-paths is not enabled for labeled-unicast IPv6 routes.",
    "CLIs": [
        "label-ipv6 send <send-limit>",
        "label-ipv6 send <send-limit> receive [ none ]",
        "no label-ipv6"
    ],
    "ParentView": [
        "config>router>bgp>add-paths",
        "config>router>bgp>group>add-paths",
        "config>router>bgp>group>neighbor>add-paths"
    ],
    "ParaDef": [
        {
            "Parameters": "send-limit",
            "Info": "Specifies the maximum number of paths per labeled-unicast IPv6 prefix that are allowed to be advertised to add-paths peers. (The actual number of advertised routes may be less.) If the value is none, the router does not negotiate the send capability with respect to label-IPv6 AFI/SAFI. Values-1 to 16, none."
        },
        {
            "Parameters": "receive",
            "Info": "Specifies that the router negotiates to receive multiple labeled-unicast routes per IPv6 prefix."
        },
        {
            "Parameters": "none",
            "Info": "Specifies that the router does not negotiate to receive multiple labeled-unicast routes per IPv6 prefix."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no label-ipv6"
}
{
    "PageTitle": "ipv6",
    "FuncDef": "This command configures the add-paths capability for unlabeled IPv6 unicast routes. By default, add-paths is not enabled for unlabeled IPv6 unicast routes.",
    "CLIs": [
        "ipv6 send <send-limit> receive [ none ]",
        "ipv6 send <send-limit>",
        "no ipv6"
    ],
    "ParentView": [
        "config>router>bgp>add-paths",
        "config>router>bgp>group>add-paths",
        "config>router>bgp>group>neighbor>add-paths"
    ],
    "ParaDef": [
        {
            "Parameters": "send send-limit",
            "Info": "Specifies the maximum number of paths per unlabeled IPv6 unicast prefix that are allowed to be advertised to add-paths peers. (The actual number of advertised routes may be less.) If the value is none, the router does not negotiate the send capability with respect to IPv6 AFI/SAFI. Values-1 to 16, none."
        },
        {
            "Parameters": "receive",
            "Info": "Specifies the router negotiates to receive multiple unlabeled unicast routes per IPv6 prefix."
        },
        {
            "Parameters": "none",
            "Info": "Specifies the router does not negotiate to receive multiple unlabeled unicast routes per IPv6 prefix."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no ipv6"
}
{
    "PageTitle": "extended-nh-encoding",
    "FuncDef": "This command configures BGP to advertise (at session OPEN) the capability to receive label IPv4, VPN IPv4 routes, or IPv6 next hops from the peers. These peers should not send such routes unless they receive notification of this capability. If the SR OS router receives a label IPv4 or VPN IPv4 route from a peer to which it did not advertise the necessary capability, the UPDATE message will be considered malformed and this will cause either session reset ortreat-as-withdrawbehavior depending on the error handling settings.",
    "CLIs": [
        "extended-nh-encoding [ label-ipv4 ] [ vpn-ipv4 ]",
        "no extended-nh-encoding"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "label-ipv4",
            "Info": "Instructs BGP to advertise an extended NH encoding capability for NLRI AFI=1, NLRI SAFI=4, and next-hop AFI=2."
        },
        {
            "Parameters": "vpn-ipv4",
            "Info": "Instructs BGP to advertise an extended NH encoding capability for NLRI AFI=1, NLRI SAFI=128, and next-hop AFI=2."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no extended-nh-encoding"
}
{
    "PageTitle": "damp-peer-oscillations",
    "FuncDef": "This command controls how long a BGP peer session remains in the idle-state after some type of error causes the session to reset. In the idle state, BGP does not initiate or respond to attempts to establish a new session. Repeated errors that occur a short while after each session reset cause longer and longer hold times in the idle state. This command supports the DampPeerOscillations FSM behavior described in section 8.1 of RFC 4271,A Border Gateway Protocol 4 (BGP-4).",
    "CLIs": [
        "damp-peer-oscillations [ idle-hold-time <initial-wait> <second-wait> <max-wait> ] [ error-interval <minutes> ]"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "initial-wait",
            "Info": "The amount of time, in minutes, that a session remains in the idle-state after it has been stable for a while. Values-0 to 2048. ParamDefault: Default- 0"
        },
        {
            "Parameters": "second-wait",
            "Info": "A period of time, in minutes, that is doubled after each repeated session failure that occurs within a relatively short span of time. Values-1 to 2048. ParamDefault: Default- 5"
        },
        {
            "Parameters": "max-wait",
            "Info": "The maximum amount of time, in minutes, that a session remains in the idle-state after it has experienced repeated instability. Values-1 to 2048. ParamDefault: Default- 60"
        },
        {
            "Parameters": "minutes",
            "Info": "The interval of time, in minutes after a session reset, during which the session must be error-free in order to reset the penalty counter and return to idle-hold-time to initial-wait. Values-0 to 2048. ParamDefault: Default- 30"
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no damp-peer-oscillations"
}
{
    "PageTitle": "rapid-withdrawal",
    "FuncDef": "This command disables the delay (Minimum Route Advertisement) on sending BGP withdrawals. Normal route withdrawals may be delayed up to the minimum route advertisement to allow for efficient packing of BGP updates.",
    "CLIs": [
        "rapid-withdrawal",
        "no rapid-withdrawal"
    ],
    "ParentView": [
        "config>router>bgp"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no rapid-withdrawal"
}
{
    "PageTitle": "disable-capability-negotiation",
    "FuncDef": "This command disables capability negotiation. When the command is enabled and after the peering is flapped, any new capabilities are not negotiated and will strictly support IPv4 routing exchanges with that peer.",
    "CLIs": [
        "disable-capability-negotiation",
        "no disable-capability-negotiation"
    ],
    "ParentView": [
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no disable-capability-negotiation"
}
{
    "PageTitle": "vpn-apply-import",
    "FuncDef": "This command causes the base instance BGP import route policies to be applied to vpn-ipv4/6, mvpn-ipv4/6, l2-vpn, mdt-safi, mcast-vpn-ipv4, and evpn routes.",
    "CLIs": [
        "vpn-apply-import",
        "no vpn-apply-import"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no vpn-apply-import"
}
{
    "PageTitle": "always-compare-med",
    "FuncDef": "This command configures the comparison of BGP routes based on the MED attribute. The default behavior of SR-OS (equivalent to thenoform of the command) is to only compare two routes on the basis of MED if they have the same neighbor AS (the first non-confed AS in the received AS_PATH attribute). Also by default, a route without a MED attribute is handled the same as though it had a MED attribute with the value 0. Thealways-compare-medcommand without thestrict-askeyword allows MED to be compared even if the paths have a different neighbor AS; in this case, if neitherzeroorinfinityis specified, thezerooption is inferred, meaning a route without a MED is handled the same as though it had a MED attribute with the value 0. When thestrict-askeyword is present, MED is only compared between paths from the same neighbor AS,\nand in this case,zeroorinfinityis mandatory and tells BGP how to interpret paths without a MED attribute.",
    "CLIs": [
        "always-compare-med { zero | infinity }",
        "no always-compare-med strict-as { zero | infinity }",
        "no always-compare-med"
    ],
    "ParentView": [
        "config>router>bgp>best-path-selection",
        "config>service>vprn>bgp>best-path-selection"
    ],
    "ParaDef": [
        {
            "Parameters": "zero",
            "Info": "Specifies that for routes learned without a MED attribute that a zero (0) value is used in the MED comparison. The routes with the lowest metric are the most preferred."
        },
        {
            "Parameters": "infinity",
            "Info": "Specifies for routes learned without a MED attribute that a value of infinity (2^32-1) is used in the MED comparison. This in effect makes these routes the least desirable."
        },
        {
            "Parameters": "strict-as",
            "Info": "Specifies BGP paths to be compared even with different neighbor AS."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no always-compare-med"
}
{
    "PageTitle": "policy",
    "FuncDef": "This command specifies the name of a policy statement to use with the BGP next-hop resolution process. The policy controls which IP routes in RTM are eligible to resolve the BGP next-hop addresses of IPv4 and IPv6 routes. The policy has no effect on the resolution of BGP next-hops to MPLS tunnels. If a BGP next-hop of an IPv4 or IPv6 route R is resolved in RTM and the longest matching route for the next-hop address is an IP route N that is rejected by the policy then route R is unresolved; if the route N is accepted by the policy then it becomes the resolving route for R.",
    "CLIs": [
        "policy <policy-name>",
        "no policy"
    ],
    "ParentView": [
        "config>router>bgp>next-hop-resolution"
    ],
    "ParaDef": [
        {
            "Parameters": "policy-name",
            "Info": "Specifies the route policy name. Allowed values are any string up to 64 characters long composed of printable, 7-bit ASCII characters. If the string contains special characters (#, $, spaces, and so on), the entire string must be enclosed within double quotes. Route policies are configured in the config>router>policy-options context."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no policy"
}
{
    "PageTitle": "bgp",
    "FuncDef": "This command creates the BGP protocol instance and BGP configuration context. BGP is administratively enabled upon creation.",
    "CLIs": [
        "bgp",
        "no bgp"
    ],
    "ParentView": [
        "config>router"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": ""
}
{
    "PageTitle": "prefix-limit",
    "FuncDef": "This command configures the maximum number of BGP routes that can be received from a peer before some administrative action is taken. The administrative action can be the generation of a log event or taking down the session. If a session is taken down, then it can be brought back up automatically after an idle-timeout period, or else it can be configured to stay down ('forever') until the operator performs a reset.",
    "CLIs": [
        "prefix-limit <family> <limit> [ threshold <percentage> ] [ idle-timeout { <minutes> | forever } | log-only ] [ post-import ]",
        "no prefix-limit <family>"
    ],
    "ParentView": [
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "log-only",
            "Info": "Enables the warning message to be sent at the specified threshold percentage, and also when the limit is reached. However, the BGP session is not taken down."
        },
        {
            "Parameters": "percentage",
            "Info": "Specifies the threshold value (as a percentage) that triggers a warning message to be sent. Values-1 to 100."
        },
        {
            "Parameters": "family",
            "Info": "Specifies the address family to which the limit applies. Values-ipv4, label-ipv4, vpn-ipv4, ipv6, label-ipv6, vpn-ipv6, mcast-ipv4, l2-vpn, mvpn-ipv4, mdt-safi, ms-pw, flow-ipv4, route-target, mcast-vpn-ipv4, mvpn-ipv6, flow-ipv6, evpn, mcast-ipv6, bgp-ls."
        },
        {
            "Parameters": "limit",
            "Info": "Specifies the number of routes that can be learned from a peer expressed as a decimal integer. Values-1 to 4294967295."
        },
        {
            "Parameters": "minutes",
            "Info": "Specifies duration in minutes before automatically re-establishing a session. Values-1 to 1024."
        },
        {
            "Parameters": "forever",
            "Info": "Specifies that the session is reestablished only after clear router bgp command is executed."
        },
        {
            "Parameters": "post-import",
            "Info": "Specifies that the limit should be applied only to the number of routes that are accepted by import policies."
        }
    ],
    "Examples": null,
    "ExtraInfo": ""
