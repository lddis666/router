You are an expert assistant in configuring network devices. Based on the user's request and the retrieved content from the router configuration manual below, generate appropriate CLI configuration commands.

---

User Request:  
How to configure a Nokia router to advertise up to 8 labeled-unicast IPv4 paths per prefix and disable receiving multiple paths?

Retrieved Reference Content (from the configuration manual):  
{
    "PageTitle": "aigp",
    "FuncDef": "This command enables or disables Accumulated IGP (AIGP) path attribute support with one or more BGP peers. BGP path selection among routes with an associated AIGP metric is based on the end-to-end IGP metrics of the different BGP paths, even when these BGP paths span more than one AS and IGP instance.",
    "CLIs": [
        "aigp",
        "no aigp"
    ],
    "ParentView": [
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no aigp"
}
{
    "PageTitle": "primary-ip-address",
    "FuncDef": "This command specifies the primary IP address of a reference location used for BGP optimal route reflection. Up to three IPv4 addresses and three IPv6 addresses can be specified per location.",
    "CLIs": [
        "primary-ip-address <ipv4-address>",
        "no primary-ip-address"
    ],
    "ParentView": [
        "config>router>bgp>orr>location"
    ],
    "ParaDef": [
        {
            "Parameters": "ipv4-address",
            "Info": "Specifies the primary IPv4 address of a location expressed in dotted decimal notation. Values-a.b.c.d."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no primary-ip-address"
}
{
    "PageTitle": "next-hop-self",
    "FuncDef": "This command configures BGP to advertise routes to members of a group or to a specific neighbor using a local address of the BGP instance as the BGP next-hop address. Note thatnext-hop-selfis set without exception, regardless of the route source (EBGP or IBGP) or its family. When used with VPN-IPv4 and VPN-IPv6 routes theenable-rr-vpn-forwardingcommand should also be configured.",
    "CLIs": [
        "next-hop-self",
        "no next-hop-self"
    ],
    "ParentView": [
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no next-hop-self"
}
{
    "PageTitle": "ebgp-ibgp-equal",
    "FuncDef": "This command instructs the BGP decision process to ignore the difference between EBGP and IBGP routes in selecting the best path and eligible multipaths (if multipath and ECMP are enabled). The result is a form of EIBGP load-balancing in a multipath scenario.",
    "CLIs": [
        "ebgp-ibgp-equal [ ipv4 ] [ ipv6 ] [ label-ipv4 ] [ label-ipv6 ] [ vpn-ipv4 ] [ vpn-ipv6 ]",
        "no ebgp-ibgp-equal"
    ],
    "ParentView": [
        "config>router>bgp>best-path-selection"
    ],
    "ParaDef": [
        {
            "Parameters": "ipv4",
            "Info": "Specifies that the command should be applied to unlabeled unicast IPv4 routes."
        },
        {
            "Parameters": "ipv6",
            "Info": "Specifies that the command should be applied to unlabeled unicast IPv6 routes."
        },
        {
            "Parameters": "label-ipv4",
            "Info": "Specifies that the command should be applied to labeled unicast IPv4 routes."
        },
        {
            "Parameters": "label-ipv6",
            "Info": "Specifies that the command should be applied to labeled unicast IPv6 routes."
        },
        {
            "Parameters": "vpn-ipv4",
            "Info": "Specifies that the command should be applied to IPv4 VPN routes."
        },
        {
            "Parameters": "vpn-ipv6",
            "Info": "Specifies that the command should be applied to IPv6 VPN routes."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no ebgp-ibgp-equal"
}
{
    "PageTitle": "primary-ipv6-address",
    "FuncDef": "This command specifies the primary IPv6 address of a reference location used for BGP optimal route reflection. Up to three IPv4 addresses and three IPv6 addresses can be specified per location.",
    "CLIs": [
        "primary-ipv6-address <ipv6-address>",
        "no primary-ipv6-address"
    ],
    "ParentView": [
        "config>router>bgp>orr>location"
    ],
    "ParaDef": [
        {
            "Parameters": "ipv6-address",
            "Info": "Specifies the primary IPv6 address of a location expressed in dotted decimal notation. Values-ipv6-address:."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no primary-ipv6-address"
}
{
    "PageTitle": "extended-nh-encoding",
    "FuncDef": "This command configures BGP to advertise (at session OPEN) the capability to receive label IPv4, VPN IPv4 routes, or IPv6 next hops from the peers. These peers should not send such routes unless they receive notification of this capability. If the SR OS router receives a label IPv4 or VPN IPv4 route from a peer to which it did not advertise the necessary capability, the UPDATE message will be considered malformed and this will cause either session reset ortreat-as-withdrawbehavior depending on the error handling settings.",
    "CLIs": [
        "extended-nh-encoding [ label-ipv4 ] [ vpn-ipv4 ]",
        "no extended-nh-encoding"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "label-ipv4",
            "Info": "Instructs BGP to advertise an extended NH encoding capability for NLRI AFI=1, NLRI SAFI=4, and next-hop AFI=2."
        },
        {
            "Parameters": "vpn-ipv4",
            "Info": "Instructs BGP to advertise an extended NH encoding capability for NLRI AFI=1, NLRI SAFI=128, and next-hop AFI=2."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no extended-nh-encoding"
}
{
    "PageTitle": "as-path-ignore",
    "FuncDef": "This command configures whether AS path length is considered in the selection of the best BGP route for a prefix.",
    "CLIs": [
        "as-path-ignore [ ipv4 ] [ label-ipv4 ] [ vpn-ipv4 ] [ ipv6 ] [ label-ipv6 ] [ vpn-ipv6 ] [ mcast-ipv4 ] [ mcast-ipv6 ] [ mvpn-ipv4 ] [ mvpn-ipv6 ] [ l2-vpn ]",
        "no as-path-ignore"
    ],
    "ParentView": [
        "config>router>bgp>best-path-selection"
    ],
    "ParaDef": [
        {
            "Parameters": "ipv4",
            "Info": "Specifies that the AS-path length will be ignored for all unlabeled unicast IPv4 routes."
        },
        {
            "Parameters": "label-ipv4",
            "Info": "Specifies that the AS-path length will be ignored for all labeled-unicast IPv4 routes."
        },
        {
            "Parameters": "vpn-ipv4",
            "Info": "Specifies that the length AS-path will be ignored for all IPv4 VPRN (SAFI 128) routes."
        },
        {
            "Parameters": "ipv6",
            "Info": "Specifies that the AS-path length will be ignored for all unlabeled unicast IPv6 routes."
        },
        {
            "Parameters": "label-ipv6",
            "Info": "Specifies that the AS-path length will be ignored for all labeled-unicast IPv6 routes."
        },
        {
            "Parameters": "vpn-ipv6",
            "Info": "Specifies that the AS-path length will be ignored for all IPv6 VPRN (SAFI 128) routes."
        },
        {
            "Parameters": "mcast-ipv4",
            "Info": "Specifies that the AS-path length will be ignored for all IPv4 multicast routes."
        },
        {
            "Parameters": "mcast-ipv6",
            "Info": "Specifies that the AS-path length will be ignored for all IPv6 multicast routes."
        },
        {
            "Parameters": "mvpn-ipv4",
            "Info": "Specifies that the AS-path length will be ignored for all IPv4 MVPN routes."
        },
        {
            "Parameters": "mvpn-ipv6",
            "Info": "Specifies that the AS-path length will be ignored for all IPv6 MVPN routes."
        },
        {
            "Parameters": "l2-vpn",
            "Info": "The AS-path length will be ignored for all L2-VPN NLRIs."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no as-path-ignore"
}
{
    "PageTitle": "damp-peer-oscillations",
    "FuncDef": "This command controls how long a BGP peer session remains in the idle-state after some type of error causes the session to reset. In the idle state, BGP does not initiate or respond to attempts to establish a new session. Repeated errors that occur a short while after each session reset cause longer and longer hold times in the idle state. This command supports the DampPeerOscillations FSM behavior described in section 8.1 of RFC 4271,A Border Gateway Protocol 4 (BGP-4).",
    "CLIs": [
        "damp-peer-oscillations [ idle-hold-time <initial-wait> <second-wait> <max-wait> ] [ error-interval <minutes> ]"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "initial-wait",
            "Info": "The amount of time, in minutes, that a session remains in the idle-state after it has been stable for a while. Values-0 to 2048. ParamDefault: Default- 0"
        },
        {
            "Parameters": "second-wait",
            "Info": "A period of time, in minutes, that is doubled after each repeated session failure that occurs within a relatively short span of time. Values-1 to 2048. ParamDefault: Default- 5"
        },
        {
            "Parameters": "max-wait",
            "Info": "The maximum amount of time, in minutes, that a session remains in the idle-state after it has experienced repeated instability. Values-1 to 2048. ParamDefault: Default- 60"
        },
        {
            "Parameters": "minutes",
            "Info": "The interval of time, in minutes after a session reset, during which the session must be error-free in order to reset the penalty counter and return to idle-hold-time to initial-wait. Values-0 to 2048. ParamDefault: Default- 30"
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no damp-peer-oscillations"
}
{
    "PageTitle": "rapid-withdrawal",
    "FuncDef": "This command disables the delay (Minimum Route Advertisement) on sending BGP withdrawals. Normal route withdrawals may be delayed up to the minimum route advertisement to allow for efficient packing of BGP updates.",
    "CLIs": [
        "rapid-withdrawal",
        "no rapid-withdrawal"
    ],
    "ParentView": [
        "config>router>bgp"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no rapid-withdrawal"
}
{
    "PageTitle": "label-ipv4",
    "FuncDef": "This command configures the add-paths capability for labeled-unicast IPv4 routes. By default, add-paths is not enabled for labeled-unicast IPv4 routes.",
    "CLIs": [
        "label-ipv4 send <send-limit>",
        "label-ipv4 send <send-limit> receive [ none ]",
        "no label-ipv4"
    ],
    "ParentView": [
        "config>router>bgp>add-paths",
        "config>router>bgp>group>add-paths",
        "config>router>bgp>group>neighbor>add-paths"
    ],
    "ParaDef": [
        {
            "Parameters": "send-limit",
            "Info": "Specifies the maximum number of paths per labeled-unicast IPv4 prefix that are allowed to be advertised to add-paths peers. (The actual number of advertised routes may be less.) If the value is none, the router does not negotiate the send capability with respect to label-IPv4 AFI/SAFI. Values-1 to 16, none."
        },
        {
            "Parameters": "receive",
            "Info": "Specifies the router negotiates to receive multiple labeled-unicast routes per IPv4 prefix."
        },
        {
            "Parameters": "none",
            "Info": "Specifies that the router does not negotiate to receive multiple labeled-unicast routes per IPv4 prefix."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no label-ipv4"
}
{
    "PageTitle": "bgp",
    "FuncDef": "This command creates the BGP protocol instance and BGP configuration context. BGP is administratively enabled upon creation.",
    "CLIs": [
        "bgp",
        "no bgp"
    ],
    "ParentView": [
        "config>router"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": ""
}
{
    "PageTitle": "dynamic-neighbor-limit",
    "FuncDef": "This command configures the maximum number of dynamic BGP sessions that will be accepted from remote peers associated with the entire BGP instance or a specific peer group. If accepting a new dynamic session would cause either the group limit or the instance limit to be exceeded, then the new session attempt is rejected and a Notification message is sent back to the remote peer.",
    "CLIs": [
        "dynamic-neighbor-limit <peers>",
        "no dynamic-neighbor-limit"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group"
    ],
    "ParaDef": [
        {
            "Parameters": "peers",
            "Info": "The maximum number of dynamic BGP sessions. Values-1 to 8192."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no dynamic-neighbor-limit"
}
{
    "PageTitle": "transport-tunnel",
    "FuncDef": "This command enables the context to configure options for the next-hop resolution of BGP labeled routes (VPN-IP and labeled-unicast) using tunnels in TTM. The context allows the selection of different tunnel resolution options for different types of BGP labeled routes: label-unicast IPv4, label-unicast IPv6, and VPN-IP routes (both VPN-IPv4 and VPN-IPv6).",
    "CLIs": [
        "transport-tunnel"
    ],
    "ParentView": [
