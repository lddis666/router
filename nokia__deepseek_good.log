        best-path-selection
            ebgp-ibgp-equal vpn-ipv4 vpn-ipv6
        exit

        # Configure transport tunnel for labeled routes
        next-hop-resolution
            labeled-routes
                transport-tunnel
                    # Add tunnel configuration as needed
                exit
            exit
        exit

        # Configure prefix limits for VPN routes
        group <group-name>
            prefix-limit vpn-ipv4 <limit> threshold <percentage>
            prefix-limit vpn-ipv6 <limit> threshold <percentage>
        exit
    exit
exit
```

