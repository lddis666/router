You are an expert assistant in configuring network devices. Based on the user's request and the retrieved content from the router configuration manual below, generate appropriate CLI configuration commands.

---

User Request:  
How to configure Nokia routers to use RSVP tunnels with the lowest metric for BGP next-hop resolution when multiple equal-cost paths exist?

Retrieved Reference Content (from the configuration manual):  
{
    "PageTitle": "import",
    "FuncDef": "This command specifies route policies that control the handling of inbound routes received from certain peers. Route policies are configured in theconfig>router>policy-optionscontext.",
    "CLIs": [
        "import <plcy-or-long-expr> [ <plcy-or-expr> [ <plcy-or-expr> ] ]",
        "no import"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "plcy-or-long-expr",
            "Info": "Specifies the route policy name (up to 64 characters long) or a policy logical expression (up to 255 characters long). Allowed values are any string up to 255 characters long composed of printable, 7-bit ASCII characters. If the string contains special characters (#, $, spaces, and so on), the entire string must be enclosed within double quotes."
        },
        {
            "Parameters": "plcy-or-expr",
            "Info": "Specifies the route policy name (up to 64 characters long) or a policy logical expression (up to 64 characters long). Allowed values are any string up to 64 characters long composed of printable, 7-bit ASCII characters. If the string contains special characters (#, $, spaces, and so on), the entire string must be enclosed within double quotes."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no import"
}
{
    "PageTitle": "ttl-security",
    "FuncDef": "This command configures TTL security parameters for incoming packets. When the feature is enabled, BGP will accept incoming IP packets from a peer only if the TTL value in the packet is greater than or equal to the minimum TTL value configured for that peer.",
    "CLIs": [
        "ttl-security <min-ttl-value>",
        "no ttl-security"
    ],
    "ParentView": [
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "min-ttl-value",
            "Info": "Specifies the minimum TTL value for an incoming packet. Values-1 to 255. ParamDefault: Default- 1"
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no ttl-security"
}
{
    "PageTitle": "ebgp-ibgp-equal",
    "FuncDef": "This command instructs the BGP decision process to ignore the difference between EBGP and IBGP routes in selecting the best path and eligible multipaths (if multipath and ECMP are enabled). The result is a form of EIBGP load-balancing in a multipath scenario.",
    "CLIs": [
        "ebgp-ibgp-equal [ ipv4 ] [ ipv6 ] [ label-ipv4 ] [ label-ipv6 ] [ vpn-ipv4 ] [ vpn-ipv6 ]",
        "no ebgp-ibgp-equal"
    ],
    "ParentView": [
        "config>router>bgp>best-path-selection"
    ],
    "ParaDef": [
        {
            "Parameters": "ipv4",
            "Info": "Specifies that the command should be applied to unlabeled unicast IPv4 routes."
        },
        {
            "Parameters": "ipv6",
            "Info": "Specifies that the command should be applied to unlabeled unicast IPv6 routes."
        },
        {
            "Parameters": "label-ipv4",
            "Info": "Specifies that the command should be applied to labeled unicast IPv4 routes."
        },
        {
            "Parameters": "label-ipv6",
            "Info": "Specifies that the command should be applied to labeled unicast IPv6 routes."
        },
        {
            "Parameters": "vpn-ipv4",
            "Info": "Specifies that the command should be applied to IPv4 VPN routes."
        },
        {
            "Parameters": "vpn-ipv6",
            "Info": "Specifies that the command should be applied to IPv6 VPN routes."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no ebgp-ibgp-equal"
}
{
    "PageTitle": "local-address",
    "FuncDef": "This command configures the local IP address used by the local router when communicating with the BMP monitoring station. This configuration is optional.",
    "CLIs": [
        "local-address { <ip-address> | <ipv6-address> }",
        "no local-address"
    ],
    "ParentView": [
        "config>bmp>station>connection"
    ],
    "ParaDef": [
        {
            "Parameters": "ip-address",
            "Info": "Specifies the local address expressed in dotted decimal notation. Allowed value is a valid routable IP address on the router, either an interface or system IP address. Values-ipv4-address:."
        },
        {
            "Parameters": "ipv6-address",
            "Info": "Specifies the local address expressed in dotted decimal notation. Allowed value is a valid routable IPv6 address on the router, either an interface or system IPv6 address. Values-ipv6-address:."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: local-address ip-address (system IP address)"
}
{
    "PageTitle": "export",
    "FuncDef": "This command specifies route policies that control the handling of outbound routes transmitted to certain peers. Route policies are configured in theconfig>router>policy-optionscontext.",
    "CLIs": [
        "export <plcy-or-long-expr> [ <plcy-or-expr> [ <plcy-or-expr> ] ]",
        "no export [ <plcy-or-long-expr> ]"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "plcy-or-long-expr",
            "Info": "Specifies the route policy name (up to 64 characters) or a policy logical expression (up to 255 characters long). Allowed values are any string up to 255 characters long composed of printable, 7-bit ASCII characters. If the string contains special characters (#, $, spaces, and so on), the entire string must be enclosed within double quotes."
        },
        {
            "Parameters": "plcy-or-expr",
            "Info": "Specifies up to 14 route policy names (up to 64 characters each) or a policy logical expression (up to 64 characters long). Allowed values are any string up to 64 characters long composed of printable, 7-bit ASCII characters. If the string contains special characters (#, $, spaces, and so on), the entire string must be enclosed within double quotes."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no export"
}
{
    "PageTitle": "damp-peer-oscillations",
    "FuncDef": "This command controls how long a BGP peer session remains in the idle-state after some type of error causes the session to reset. In the idle state, BGP does not initiate or respond to attempts to establish a new session. Repeated errors that occur a short while after each session reset cause longer and longer hold times in the idle state. This command supports the DampPeerOscillations FSM behavior described in section 8.1 of RFC 4271,A Border Gateway Protocol 4 (BGP-4).",
    "CLIs": [
        "damp-peer-oscillations [ idle-hold-time <initial-wait> <second-wait> <max-wait> ] [ error-interval <minutes> ]"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "initial-wait",
            "Info": "The amount of time, in minutes, that a session remains in the idle-state after it has been stable for a while. Values-0 to 2048. ParamDefault: Default- 0"
        },
        {
            "Parameters": "second-wait",
            "Info": "A period of time, in minutes, that is doubled after each repeated session failure that occurs within a relatively short span of time. Values-1 to 2048. ParamDefault: Default- 5"
        },
        {
            "Parameters": "max-wait",
            "Info": "The maximum amount of time, in minutes, that a session remains in the idle-state after it has experienced repeated instability. Values-1 to 2048. ParamDefault: Default- 60"
        },
        {
            "Parameters": "minutes",
            "Info": "The interval of time, in minutes after a session reset, during which the session must be error-free in order to reset the penalty counter and return to idle-hold-time to initial-wait. Values-0 to 2048. ParamDefault: Default- 30"
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no damp-peer-oscillations"
}
{
    "PageTitle": "vpn-apply-import",
    "FuncDef": "This command causes the base instance BGP import route policies to be applied to vpn-ipv4/6, mvpn-ipv4/6, l2-vpn, mdt-safi, mcast-vpn-ipv4, and evpn routes.",
    "CLIs": [
        "vpn-apply-import",
        "no vpn-apply-import"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no vpn-apply-import"
}
{
    "PageTitle": "rapid-withdrawal",
    "FuncDef": "This command disables the delay (Minimum Route Advertisement) on sending BGP withdrawals. Normal route withdrawals may be delayed up to the minimum route advertisement to allow for efficient packing of BGP updates.",
    "CLIs": [
        "rapid-withdrawal",
        "no rapid-withdrawal"
    ],
    "ParentView": [
        "config>router>bgp"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no rapid-withdrawal"
}
{
    "PageTitle": "helper-override-restart-time",
    "FuncDef": "This command overrides the restart-time advertised by a peer (in its GR capability) with a locally-configured value. This override applies only to AFI/SAFI that were included in the GR capability of the peer. The restart-time is always zero for AFI/SAFI not included in the GR capability. This command is useful if the local router wants to force LLGR phase to begin after a set time for all protected AFI/SAFI.",
    "CLIs": [
        "helper-override-restart-time <seconds>",
        "no helper-override-restart-time"
    ],
    "ParentView": [
        "config>router>bgp>graceful-restart>long-lived",
        "config>router>bgp>group>graceful-restart>long-lived",
        "config>router>bgp>group>neighbor>graceful-restart>long-lived"
    ],
    "ParaDef": [
        {
            "Parameters": "seconds",
            "Info": "The locally-imposed restart time for all AFI/SAFI included in the peer s GR capability. Values-0 to 4095."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no helper-override-restart-time"
}
{
    "PageTitle": "enable-origin-validation",
    "FuncDef": "When theenable-origin-validationcommand is added to the configuration of a group or neighbor, it causes every inbound IPv4 and/or IPv6 route from that peer to be marked with one of the 3 following origin validation states:",
    "CLIs": [
        "enable-origin-validation [ ipv4 ] [ ipv6 ] [ label-ipv4 ] [ label-ipv6 ]",
        "no enable-origin-validation"
    ],
    "ParentView": [
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "ipv4",
            "Info": "Enables origin validation processing for unlabeled unicast IPv4 routes."
        },
        {
            "Parameters": "ipv6",
            "Info": "Enables origin validation processing for unlabeled unicast IPv6 routes."
        },
        {
            "Parameters": "label-ipv4",
            "Info": "Enables origin validation processing for labeled IPv4 routes."
        },
        {
            "Parameters": "label-ipv6",
            "Info": "Enables origin validation processing for labeled IPv6 routes."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no enable-origin-validation"
}
{
    "PageTitle": "sr-ospf3",
    "FuncDef": "This command selects the IPv6 segment routing tunnel type programmed by an OSPFv3 instance in the TTMv6 for next-hop resolution of BGP routes and labeled routes. This option allows BGP to use the segment routing tunnel in the tunnel table submitted by the lowest preference OSPFv3 instance or, in case of a tie, the lowest-numbered OSPFv3 instance.",
    "CLIs": [
        "sr-ospf3",
        "no sr-ospf3"
    ],
    "ParentView": [
        "config>router>bgp>next-hop-resolution>shortcut-tunn>family>resolution-filter",
        "config>router>bgp>next-hop-resolution>labeled-routes>transport-tunnel>family>resolution-filter"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": ""
}
{
    "PageTitle": "bgp",
    "FuncDef": "This command creates the BGP protocol instance and BGP configuration context. BGP is administratively enabled upon creation.",
    "CLIs": [
        "bgp",
        "no bgp"
    ],
    "ParentView": [
        "config>router"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": ""
}
{
    "PageTitle": "transport-tunnel",
    "FuncDef": "This command enables the context to configure options for the next-hop resolution of BGP labeled routes (VPN-IP and labeled-unicast) using tunnels in TTM. The context allows the selection of different tunnel resolution options for different types of BGP labeled routes: label-unicast IPv4, label-unicast IPv6, and VPN-IP routes (both VPN-IPv4 and VPN-IPv6).",
    "CLIs": [
        "transport-tunnel"
    ],
    "ParentView": [
        "config>router>bgp>next-hop-res>labeled-routes"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": ""
}
{
    "PageTitle": "disable-4byte-asn",
    "FuncDef": "This command disables the use of 4-byte ASNs. It can be configured at all 3 level of the hierarchy so it can be specified down to the per peer basis.",
    "CLIs": [
        "disable-4byte-asn",
        "no disable-4byte-asn"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no disable-4byte-asn"
}
{
    "PageTitle": "prefix-limit",
    "FuncDef": "This command configures the maximum number of BGP routes that can be received from a peer before some administrative action is taken. The administrative action can be the generation of a log event or taking down the session. If a session is taken down, then it can be brought back up automatically after an idle-timeout period, or else it can be configured to stay down ('forever') until the operator performs a reset.",
    "CLIs": [
        "prefix-limit <family> <limit> [ threshold <percentage> ] [ idle-timeout { <minutes> | forever } | log-only ] [ post-import ]",
        "no prefix-limit <family>"
    ],
    "ParentView": [
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "log-only",
            "Info": "Enables the warning message to be sent at the specified threshold percentage, and also when the limit is reached. However, the BGP session is not taken down."
        },
        {
            "Parameters": "percentage",
            "Info": "Specifies the threshold value (as a percentage) that triggers a warning message to be sent. Values-1 to 100."
        },
        {
            "Parameters": "family",
            "Info": "Specifies the address family to which the limit applies. Values-ipv4, label-ipv4, vpn-ipv4, ipv6, label-ipv6, vpn-ipv6, mcast-ipv4, l2-vpn, mvpn-ipv4, mdt-safi, ms-pw, flow-ipv4, route-target, mcast-vpn-ipv4, mvpn-ipv6, flow-ipv6, evpn, mcast-ipv6, bgp-ls."
        },
        {
            "Parameters": "limit",
            "Info": "Specifies the number of routes that can be learned from a peer expressed as a decimal integer. Values-1 to 4294967295."
        },
        {
            "Parameters": "minutes",
            "Info": "Specifies duration in minutes before automatically re-establishing a session. Values-1 to 1024."
        },
        {
            "Parameters": "forever",
            "Info": "Specifies that the session is reestablished only after clear router bgp command is executed."
        },
        {
            "Parameters": "post-import",
            "Info": "Specifies that the limit should be applied only to the number of routes that are accepted by import policies."
        }
    ],
    "Examples": null,
    "ExtraInfo": ""
}
{
    "PageTitle": "autonomous-system",
    "FuncDef": "This command configures the autonomous system (AS) number for the router. A router can only belong to one AS. An AS number is a globally unique number with an AS. This number is used to exchange exterior routing information with neighboring ASs and as an identifier of the AS itself.",
    "CLIs": [
        "autonomous-system <autonomous-system-number>",
        "no autonomous-system"
    ],
    "ParentView": [
        "config>router"
    ],
    "ParaDef": [
        {
            "Parameters": "autonomous-system-number",
            "Info": "Specifies the autonomous system number, expressed as a decimal integer. Values-1 to 4294967295."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no autonomous-system"
}
{
    "PageTitle": "ignore-router-id",
    "FuncDef": "When theignore-router-idcommand is present, and the current best path to a destination was learned from EBGP peer X with BGP identifier x and a new path is received from EBGP peer Y with BGP identifier y, the best path remains unchanged if the new path is equivalent to the current best path up to the BGP identifier comparison - even if y is less than x.",
    "CLIs": [
        "ignore-router-id include-internal <family> [ <family> ]",
        "[ no ] ignore-router-id"
    ],
    "ParentView": [
        "config>router>bgp>best-path-selection",
        "config>service>vprn>bgp>best-path-selection"
    ],
    "ParaDef": [
        {
            "Parameters": "family",
            "Info": "Specifies up to two internal families to be included in this configuration. Values-mvpn-ipv4, mvpn-ipv6."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no ignore-router-id"
}
{
    "PageTitle": "compare-origin-validation-state",
    "FuncDef": "When this command is configured, a new step is inserted in the BGP decision process after removal of invalid routes and before the comparison of Local Preference. The new step compares the origin validation state so that a BGP route with a  Valid  state is preferred over a BGP route with a  Not-Found  state, and a BGP route with a  Not-Found  state is preferred over a BGP route with an  Invalid  state assuming that these routes are considered  usable .",
    "CLIs": [
        "compare-origin-validation-state",
        "no compare-origin-validation-state"
    ],
    "ParentView": [
        "config>router>bgp>best-path-selection"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no compare-origin-validation-state"
}
{
    "PageTitle": "enforce-first-as",
    "FuncDef": "When this command is configured so that it applies to an EBGP session, all routes (belonging to all address families) that are received from the EBGP peer are checked to ensure that the most recent autonomous system number (ASN) in the AS_PATH attribute of each route matches the configuredpeer-asof the session; if it does not match, then either the session is reset (ifupdate-fault-toleranceis not enabled) or the session is left up but the route is treated as withdrawn (ifupdate-fault-toleranceis enabled).",
    "CLIs": [
        "enforce-first-as"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": ""
}
{
    "PageTitle": "override-tunnel-elc",
    "FuncDef": "This command enables or disables entropy label capability (ELC) on BGP tunnels.",
    "CLIs": [
        "override-tunnel-elc",
        "no override-tunnel-elc"
    ],
    "ParentView": [
        "config>router>bgp"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no override-tunnel-elc"
}
{
    "PageTitle": "local-preference",
    "FuncDef": "This command enables setting the BGP local-preference attribute in incoming routes if not specified and configures the default value for the attribute.",
    "CLIs": [
        "local-preference <local-preference>",
        "no local-preference"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "local-preference",
            "Info": "Specifies the local preference value to be used as the override value expressed as a decimal integer. Values-0 to 4294967295."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no local-preference"
}
