    policy-options
        policy-statement "GR-L2VPN-FORWARDING-STATE"
            entry 10
                from
                    protocol l2vpn         # For L2VPN routes
                exit
                actions
                    forwarding-state      # Enable forwarding-state flag
                    accept
                exit
            exit
            entry 20
                from
                    protocol bgp-vpn      # For VPN routes (e.g., EVPN, VPLS)
                exit
                actions
                    forwarding-state      # Enable forwarding-state flag
                    accept
                exit
            exit
            entry 30
                from
                    family route-target   # For Route-Target routes
                exit
                actions
                    forwarding-state      # Enable forwarding-state flag
                    accept
                exit
            exit
            default-action reject         # Block forwarding-state for other routes
        exit
    exit
```

