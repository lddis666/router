```bash
configure
    policy-options
        community "LOC_PREF_8" members "target:12345:8"   # Adjust target format if needed
        policy-statement "SET_LOC_PREF"
            entry 10
                from protocol bgp
                action accept
                    community add "LOC_PREF_8"
                exit
            exit
        exit
```
Then apply this policy to inbound routes:
```bash
router bgp
    group "HUB"
        import "SET_LOC_PREF"
        exit
    exit
