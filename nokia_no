            entry 10
                from
                    protocol l2vpn
                    protocol bgp-vpn
                    family route-target
                exit
                actions
                    forwarding-state
                    accept
                exit
            exit
            default-action reject
        exit
    exit

    router "Base"
        bgp
            group "L2VPN-PEERS"
                neighbor "192.168.1.1"
                    graceful-restart
                        import-forwarding-flag-policy "GR-IMPORT-FORWARDING-STATE"  # Apply import policy
                    exit
                exit
            exit
        exit
