   ```bash
   configure router policy-options
       begin
       prefix-list "ALLOWED_TUNNELS"
           default-action deny
           entry 10
               action accept
               type mpls
           exit
           entry 20
               action accept
               type rsvp-te
           exit
       exit
       commit
   ```

