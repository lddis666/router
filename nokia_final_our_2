To configure your Nokia 7750 SR for sharing up to 8 IPv6 paths per destination via BGP while ignoring incoming paths for these routes, use the following CLI commands:

```cli
# Enable BGP multipath with a maximum of 8 paths
configure router bgp
    multipath 8
exit

# Create a routing policy to block incoming routes
configure router policy-options
    policy-statement "BLOCK_INCOMING_ROUTES"
        default-action reject
    exit
exit

# Apply the policy to BGP neighbors
configure router bgp
    group "ipv6_neighbors"
        family ipv6
        import "BLOCK_INCOMING_ROUTES"
    exit
exit
```

