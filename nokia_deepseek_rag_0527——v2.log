input_text
You are an expert assistant in configuring network devices. Based on the user's request and the retrieved content from the router configuration manual below, generate appropriate CLI configuration commands.

---

User Request:  
"How to configure a Nokia router to advertise up to 8 labeled-unicast IPv4 paths per prefix while disabling the ability to receive multiple paths?"

Retrieved Reference Content (from the configuration manual):  
{
    "PageTitle": "multipath",
    "FuncDef": "This command enables BGP multipath for all address families that support ECMP forwarding.",
    "CLIs": [
        "multipath <max-paths> [ ebgp <ebgp-max-paths> ] [ ibgp <ibgp-max-paths> ] [ restrict { same-neighbor-as | exact-as-path } ]",
        "no multipath"
    ],
    "ParentView": [
        "config>router>bgp"
    ],
    "ParaDef": [
        {
            "Parameters": "max-paths",
            "Info": "Specifies the maximum number of multipaths per prefix/NLRI if ebgp-max-paths or ibgp-max-paths does not apply. Values-1 to 64."
        },
        {
            "Parameters": "egp-max-paths",
            "Info": "Specifies the maximum number of multipaths per prefix/NLRI when the best path is an EBGP learned route. Values-1 to 64."
        },
        {
            "Parameters": "ibgp-max-paths",
            "Info": "Specifies the maximum number of multipaths per prefix/NLRI when the best path is an IBGP learned route. Values-1 to 64."
        },
        {
            "Parameters": "restrict same-neighbor-as",
            "Info": "Specifies that the non-best path must have the same neighbor AS in its AS path as the best path."
        },
        {
            "Parameters": "restrict exact-as-path-as",
            "Info": "Specifies that the non-best path must have the same AS path as the best path."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no multipath"
}
{
    "PageTitle": "allow-static",
    "FuncDef": "This command allows the BGP next-hop of label-IPv4, label-IPv6, VPN-IPv4, and VPN-IPv6 routes received from any EBGP or IBGP peer to be resolved using static routes, except for static default routes (0/0 and ::/0).",
    "CLIs": [
        "allow-static",
        "no allow-static"
    ],
    "ParentView": [
        "config>router>bgp>next-hop-res>labeled-routes"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no allow-static"
}
{
    "PageTitle": "prefix-limit",
    "FuncDef": "This command configures the maximum number of BGP routes that can be received from a peer before some administrative action is taken. The administrative action can be the generation of a log event or taking down the session. If a session is taken down, then it can be brought back up automatically after an idle-timeout period, or else it can be configured to stay down ('forever') until the operator performs a reset.",
    "CLIs": [
        "prefix-limit <family> <limit> [ threshold <percentage> ] [ idle-timeout { <minutes> | forever } | log-only ] [ post-import ]",
        "no prefix-limit <family>"
    ],
    "ParentView": [
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "log-only",
            "Info": "Enables the warning message to be sent at the specified threshold percentage, and also when the limit is reached. However, the BGP session is not taken down."
        },
        {
            "Parameters": "percentage",
            "Info": "Specifies the threshold value (as a percentage) that triggers a warning message to be sent. Values-1 to 100."
        },
        {
            "Parameters": "family",
            "Info": "Specifies the address family to which the limit applies. Values-ipv4, label-ipv4, vpn-ipv4, ipv6, label-ipv6, vpn-ipv6, mcast-ipv4, l2-vpn, mvpn-ipv4, mdt-safi, ms-pw, flow-ipv4, route-target, mcast-vpn-ipv4, mvpn-ipv6, flow-ipv6, evpn, mcast-ipv6, bgp-ls."
        },
        {
            "Parameters": "limit",
            "Info": "Specifies the number of routes that can be learned from a peer expressed as a decimal integer. Values-1 to 4294967295."
        },
        {
            "Parameters": "minutes",
            "Info": "Specifies duration in minutes before automatically re-establishing a session. Values-1 to 1024."
        },
        {
            "Parameters": "forever",
            "Info": "Specifies that the session is reestablished only after clear router bgp command is executed."
        },
        {
            "Parameters": "post-import",
            "Info": "Specifies that the limit should be applied only to the number of routes that are accepted by import policies."
        }
    ],
    "Examples": null,
    "ExtraInfo": ""
}
{
    "PageTitle": "ibgp-multipath",
    "FuncDef": "This command enables IBGP multipath load balancing when adding BGP routes to the route table if the route resolving the BGP nexthop offers multiple nexthops.",
    "CLIs": [
