```
# Configure the prefix list
/configure router policy-options
begin
prefix-list "BGP-FILTER"
    prefix 192.168.0.0/16 exact
    prefix 10.0.0.0/8 longer
exit

# Create a route policy using the prefix list
policy-statement "BGP-INBOUND-FILTER"
    entry 10
        from
            prefix-list "BGP-FILTER"
        exit
        action accept
    exit
    default-action reject
exit
commit

# Apply the policy to BGP peer(s)
/configure router bgp
group "EBGP-PEERS"
    neighbor 203.0.113.1
        import "BGP-INBOUND-FILTER"
    exit
exit
```

