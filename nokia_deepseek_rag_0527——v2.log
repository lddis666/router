        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no dynamic-neighbor-limit"
}
{
    "PageTitle": "enforce-strict-tunnel-tagging",
    "FuncDef": "This command forces the system to only consider LSPs marked with anadmin-tagfor next-hop resolution. Untagged LSPs are not be considered.",
    "CLIs": [
        "enforce-strict-tunnel-tagging",
