    "ExtraInfo": ""
}
{
    "PageTitle": "tertiary-ip-address",
    "FuncDef": "This command specifies the tertiary IP address of a reference location used for BGP optimal route reflection. Up to three IPv4 addresses and three IPv6 addresses can be specified per location.",
    "CLIs": [
        "tertiary-ip-address <ipv4-address>",
