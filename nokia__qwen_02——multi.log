You are an expert assistant in configuring network devices. Based on the user's request and the retrieved content from the router configuration manual below, generate appropriate CLI configuration commands.

---

User Request:  
How to configure Nokia router's BGP group to receive and utilize the link-bandwidth extended community for IPv6 routes advertised by EBGP peers?

Retrieved Reference Content (from the configuration manual):  
{
    "PageTitle": "add-paths",
    "FuncDef": "This command allows adds the add-paths node to be the configured for one or more families configuration of the BGP instance, a group or a neighbor. The BGP add-paths capability allows the router to send and/or receive multiple paths per prefix to/from a peer. The add-paths command without additional parameters is equivalent to removing Add-Paths support for all address families, which causes sessions that previously negotiated the add-paths capability for one or more address families to go down and come back up without the add-paths capability.",
    "CLIs": [
        "add-paths",
        "no add-paths"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no add-paths"
}
{
    "PageTitle": "outbound-route-filtering",
    "FuncDef": "This command opens the configuration tree for sending or accepting BGP filter lists from peers (outbound route filtering).",
    "CLIs": [
        "outbound-route-filtering",
        "no outbound-route-filtering"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no outbound-route-filtering"
}
{
    "PageTitle": "link-state-import-enable",
    "FuncDef": "This command enables the import of link-state information into the BGP-LS address family for advertisement to other BGP neighbors.",
    "CLIs": [
        "link-state-import-enable",
        "no link-state-import-enable"
    ],
    "ParentView": [
        "config>router>bgp"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no link-state-import-enable"
}
{
    "PageTitle": "loop-detect",
    "FuncDef": "This command configures how the BGP peer session handles loop detection in the AS path.",
    "CLIs": [
        "loop-detect { drop-peer | discard-route | ignore-loop | off }",
        "no loop-detect"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "drop-peer",
            "Info": "Sends a notification to the remote peer and drops the session."
        },
        {
            "Parameters": "discard-route",
            "Info": "Discards routes received from a peer with the same AS number as the router itself. This option prevents routes looped back to the router from being added to the routing information base and consuming memory. When this option is changed, the change will not be active for an established peer until the connection is re-established for the peer."
        },
        {
            "Parameters": "ignore-loop",
            "Info": "Ignores routes with loops in the AS path but maintains peering."
        },
        {
            "Parameters": "off",
            "Info": "Disables loop detection."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: loop-detect ignore-loop"
}
{
    "PageTitle": "bmp",
    "FuncDef": "This command enables the context to configure BGP Monitoring Protocol (BMP) parameters.",
    "CLIs": [
        "bmp"
    ],
    "ParentView": [
        "config"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": ""
}
