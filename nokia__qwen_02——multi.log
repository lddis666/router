}
{
    "PageTitle": "hold-time",
    "FuncDef": "This command configures the BGP hold time, expressed in seconds.",
    "CLIs": [
        "hold-time <seconds> [ min <seconds> ]",
        "no hold-time"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "seconds",
            "Info": "Specifies the hold-time, in seconds, expressed as a decimal integer. A value of 0 indicates the connection to the peer is up permanently. Values-0, 3 to 65535."
        },
        {
            "Parameters": "min seconds2",
            "Info": "Specifies the minimum hold-time that will be accepted for the session. If the peer proposes a hold-time lower than this value, the session attempt will be rejected."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: hold-time 90"
}
{
    "PageTitle": "label-ipv6",
    "FuncDef": "This command configures the add-paths capability for labeled-unicast IPv6 routes. By default, add-paths is not enabled for labeled-unicast IPv6 routes.",
    "CLIs": [
        "label-ipv6 send <send-limit>",
        "label-ipv6 send <send-limit> receive [ none ]",
        "no label-ipv6"
    ],
    "ParentView": [
        "config>router>bgp>add-paths",
        "config>router>bgp>group>add-paths",
        "config>router>bgp>group>neighbor>add-paths"
    ],
    "ParaDef": [
        {
            "Parameters": "send-limit",
            "Info": "Specifies the maximum number of paths per labeled-unicast IPv6 prefix that are allowed to be advertised to add-paths peers. (The actual number of advertised routes may be less.) If the value is none, the router does not negotiate the send capability with respect to label-IPv6 AFI/SAFI. Values-1 to 16, none."
        },
        {
            "Parameters": "receive",
            "Info": "Specifies that the router negotiates to receive multiple labeled-unicast routes per IPv6 prefix."
        },
        {
            "Parameters": "none",
            "Info": "Specifies that the router does not negotiate to receive multiple labeled-unicast routes per IPv6 prefix."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no label-ipv6"
}
{
    "PageTitle": "sr-ospf3",
    "FuncDef": "This command selects the IPv6 segment routing tunnel type programmed by an OSPFv3 instance in the TTMv6 for next-hop resolution of BGP routes and labeled routes. This option allows BGP to use the segment routing tunnel in the tunnel table submitted by the lowest preference OSPFv3 instance or, in case of a tie, the lowest-numbered OSPFv3 instance.",
    "CLIs": [
        "sr-ospf3",
        "no sr-ospf3"
    ],
    "ParentView": [
        "config>router>bgp>next-hop-resolution>shortcut-tunn>family>resolution-filter",
        "config>router>bgp>next-hop-resolution>labeled-routes>transport-tunnel>family>resolution-filter"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": ""
}
{
    "PageTitle": "accept-orf",
    "FuncDef": "This command instructs the router to negotiate the receive capability in the BGP ORF negotiation with a peer, and to accept filters that the peer wishes to send.",
    "CLIs": [
        "accept-orf",
        "no accept-orf"
    ],
    "ParentView": [
        "config>router>bgp>outbound-route-filtering>extended-community",
        "config>router>bgp>group>outbound-route-filtering>extended-community",
        "config>router>bgp>group>neighbor>outbound-route-filtering>extended-community"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no accept-orf"
}
{
    "PageTitle": "local-address",
    "FuncDef": "This command configures the local IP address used by the local router when communicating with the BMP monitoring station. This configuration is optional.",
    "CLIs": [
        "local-address { <ip-address> | <ipv6-address> }",
        "no local-address"
    ],
    "ParentView": [
        "config>bmp>station>connection"
    ],
    "ParaDef": [
        {
            "Parameters": "ip-address",
            "Info": "Specifies the local address expressed in dotted decimal notation. Allowed value is a valid routable IP address on the router, either an interface or system IP address. Values-ipv4-address:."
        },
        {
            "Parameters": "ipv6-address",
            "Info": "Specifies the local address expressed in dotted decimal notation. Allowed value is a valid routable IPv6 address on the router, either an interface or system IPv6 address. Values-ipv6-address:."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: local-address ip-address (system IP address)"
}
{
    "PageTitle": "ebgp-ibgp-equal",
    "FuncDef": "This command instructs the BGP decision process to ignore the difference between EBGP and IBGP routes in selecting the best path and eligible multipaths (if multipath and ECMP are enabled). The result is a form of EIBGP load-balancing in a multipath scenario.",
    "CLIs": [
        "ebgp-ibgp-equal [ ipv4 ] [ ipv6 ] [ label-ipv4 ] [ label-ipv6 ] [ vpn-ipv4 ] [ vpn-ipv6 ]",
        "no ebgp-ibgp-equal"
    ],
    "ParentView": [
        "config>router>bgp>best-path-selection"
    ],
    "ParaDef": [
        {
            "Parameters": "ipv4",
            "Info": "Specifies that the command should be applied to unlabeled unicast IPv4 routes."
        },
        {
            "Parameters": "ipv6",
            "Info": "Specifies that the command should be applied to unlabeled unicast IPv6 routes."
        },
        {
            "Parameters": "label-ipv4",
            "Info": "Specifies that the command should be applied to labeled unicast IPv4 routes."
        },
        {
            "Parameters": "label-ipv6",
            "Info": "Specifies that the command should be applied to labeled unicast IPv6 routes."
        },
        {
            "Parameters": "vpn-ipv4",
            "Info": "Specifies that the command should be applied to IPv4 VPN routes."
        },
        {
            "Parameters": "vpn-ipv6",
            "Info": "Specifies that the command should be applied to IPv6 VPN routes."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no ebgp-ibgp-equal"
}
{
    "PageTitle": "mvpn-ipv4",
    "FuncDef": "This command configures the add-paths capability for multicast VPN IPv4 routes. By default, add-paths is not enabled for multicast VPN IPv4 routes.",
    "CLIs": [
        "mvpn-ipv4 send <send-limit> receive [ none ]",
        "mvpn-ipv4 send <send-limit>",
        "no mvpn-ipv4"
    ],
    "ParentView": [
        "config>router>bgp>add-paths",
        "config>router>bgp>group>add-paths",
        "config>router>bgp>group>neighbor>add-paths"
    ],
    "ParaDef": [
        {
            "Parameters": "send-limit",
            "Info": "Specifies the maximum number of paths per multicast VPN IPv4 prefix that are allowed to be advertised to add-paths peers. The actual number of advertised routes may be less. If the value is none, the router does not negotiate the send capability with respect to multicast VPN IPv4 AFI/SAFI. ParamDefault: Default- 1 to 16, none"
        },
        {
            "Parameters": "receive",
            "Info": "Specifies that the router negotiates to receive multiple multicast VPN routes per IPv4 prefix."
        },
        {
            "Parameters": "none",
            "Info": "Specifies that the router does not negotiate to receive multiple multicast VPN routes per IPv4 prefix."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no mvpn-ipv4"
}
{
    "PageTitle": "enable-peer-tracking",
    "FuncDef": "This command enables BGP peer tracking. BGP peer tracking allows a BGP peer to be dropped immediately if the route used to resolve the BGP peer address is removed from the IP routing table and there is no alternative available. The BGP peer will not wait for the holdtimer to expire; therefore, the BGP re-convergence process is accelerated.",
    "CLIs": [
        "enable-peer-tracking",
        "no enable-peer-tracking"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no enable-peer-tracking"
}
{
    "PageTitle": "extended-nh-encoding",
    "FuncDef": "This command configures BGP to advertise (at session OPEN) the capability to receive label IPv4, VPN IPv4 routes, or IPv6 next hops from the peers. These peers should not send such routes unless they receive notification of this capability. If the SR OS router receives a label IPv4 or VPN IPv4 route from a peer to which it did not advertise the necessary capability, the UPDATE message will be considered malformed and this will cause either session reset ortreat-as-withdrawbehavior depending on the error handling settings.",
    "CLIs": [
        "extended-nh-encoding [ label-ipv4 ] [ vpn-ipv4 ]",
        "no extended-nh-encoding"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "label-ipv4",
            "Info": "Instructs BGP to advertise an extended NH encoding capability for NLRI AFI=1, NLRI SAFI=4, and next-hop AFI=2."
        },
        {
            "Parameters": "vpn-ipv4",
            "Info": "Instructs BGP to advertise an extended NH encoding capability for NLRI AFI=1, NLRI SAFI=128, and next-hop AFI=2."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no extended-nh-encoding"
}
{
    "PageTitle": "router-id",
    "FuncDef": "This command specifies the router ID to be used with this BGP instance.",
    "CLIs": [
        "router-id <ip-address>",
        "no router-id"
    ],
    "ParentView": [
        "config>router>bgp"
    ],
    "ParaDef": [
        {
            "Parameters": "ip-address",
            "Info": "Specifies the router ID, expressed as any non-zero value in the range 0.0.0.1 to 255.255.255.255 (or when converted to decimal it can have any value in the range 1-4294967295). It is recommended to use the system IPv4 address."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no router-id"
}
{
    "PageTitle": "connect-retry",
    "FuncDef": "This command configures the BGP connect retry timer value in seconds.",
    "CLIs": [
        "connect-retry <seconds>",
        "no connect-retry"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "seconds",
            "Info": "The BGP Connect Retry timer value in seconds expressed as a decimal integer. Values-1 to 65535."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: connect-retry 120"
}
{
    "PageTitle": "mcast-vpn-ipv4",
    "FuncDef": "This command configures the add-paths capability for multicast IPv4 VPN routes. By default, add-paths is not enabled for multicast IPv4 VPN routes.",
    "CLIs": [
        "mcast-vpn-ipv4 send <send-limit> receive [ none ]",
        "mcast-vpn-ipv4 send <send-limit>",
        "no mcast-vpn-ipv4"
    ],
    "ParentView": [
