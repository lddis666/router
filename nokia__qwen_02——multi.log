input_text
You are an expert assistant in configuring network devices. Based on the user's request and the retrieved content from the router configuration manual below, generate appropriate CLI configuration commands.

---

User Request:  
How to configure a Nokia router to enable BGP ORF negotiation for receiving route filters from a peer?

Retrieved Reference Content (from the configuration manual):  
{
    "PageTitle": "deterministic-med",
    "FuncDef": "This command controls how the BGP decision process compares routes on the basis of MED. Whendeterministic-medis configured, BGP groups paths that are equal up to the MED comparison step based on neighbor AS, and then compares the best path from each group to arrive at the overall best path. This change to the BGP decision process makes best path selection completely deterministic in all cases. Withoutdeterministic-med, the overall best path selection is sometimes dependent on the order of the route arrival because of the rule that MED cannot be compared in routes from different neighbor AS.",
    "CLIs": [
        "deterministic-med",
        "no deterministic-med"
    ],
    "ParentView": [
        "config>router>bgp>best-path-selection"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no deterministic-med"
}
{
    "PageTitle": "outbound-route-filtering",
    "FuncDef": "This command opens the configuration tree for sending or accepting BGP filter lists from peers (outbound route filtering).",
    "CLIs": [
        "outbound-route-filtering",
        "no outbound-route-filtering"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no outbound-route-filtering"
}
{
    "PageTitle": "link-state-import-enable",
    "FuncDef": "This command enables the import of link-state information into the BGP-LS address family for advertisement to other BGP neighbors.",
    "CLIs": [
        "link-state-import-enable",
        "no link-state-import-enable"
    ],
    "ParentView": [
        "config>router>bgp"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no link-state-import-enable"
}
{
    "PageTitle": "damp-peer-oscillations",
    "FuncDef": "This command controls how long a BGP peer session remains in the idle-state after some type of error causes the session to reset. In the idle state, BGP does not initiate or respond to attempts to establish a new session. Repeated errors that occur a short while after each session reset cause longer and longer hold times in the idle state. This command supports the DampPeerOscillations FSM behavior described in section 8.1 of RFC 4271,A Border Gateway Protocol 4 (BGP-4).",
    "CLIs": [
        "damp-peer-oscillations [ idle-hold-time <initial-wait> <second-wait> <max-wait> ] [ error-interval <minutes> ]"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "initial-wait",
            "Info": "The amount of time, in minutes, that a session remains in the idle-state after it has been stable for a while. Values-0 to 2048. ParamDefault: Default- 0"
        },
        {
            "Parameters": "second-wait",
            "Info": "A period of time, in minutes, that is doubled after each repeated session failure that occurs within a relatively short span of time. Values-1 to 2048. ParamDefault: Default- 5"
        },
        {
            "Parameters": "max-wait",
            "Info": "The maximum amount of time, in minutes, that a session remains in the idle-state after it has experienced repeated instability. Values-1 to 2048. ParamDefault: Default- 60"
        },
        {
            "Parameters": "minutes",
            "Info": "The interval of time, in minutes after a session reset, during which the session must be error-free in order to reset the penalty counter and return to idle-hold-time to initial-wait. Values-0 to 2048. ParamDefault: Default- 30"
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no damp-peer-oscillations"
}
{
    "PageTitle": "loop-detect",
    "FuncDef": "This command configures how the BGP peer session handles loop detection in the AS path.",
    "CLIs": [
        "loop-detect { drop-peer | discard-route | ignore-loop | off }",
        "no loop-detect"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "drop-peer",
            "Info": "Sends a notification to the remote peer and drops the session."
        },
        {
            "Parameters": "discard-route",
            "Info": "Discards routes received from a peer with the same AS number as the router itself. This option prevents routes looped back to the router from being added to the routing information base and consuming memory. When this option is changed, the change will not be active for an established peer until the connection is re-established for the peer."
        },
        {
            "Parameters": "ignore-loop",
            "Info": "Ignores routes with loops in the AS path but maintains peering."
        },
        {
            "Parameters": "off",
            "Info": "Disables loop detection."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: loop-detect ignore-loop"
}
{
    "PageTitle": "tertiary-ipv6-address",
    "FuncDef": "This command specifies the tertiary IPv6 address of a reference location used for BGP optimal route reflection. Up to three IPv4 addresses and three IPv6 addresses can be specified per location.",
    "CLIs": [
        "tertiary-ipv6-address <ipv6-address>",
        "no tertiary-ipv6-address"
    ],
    "ParentView": [
        "config>router>bgp>orr>location"
    ],
    "ParaDef": [
        {
            "Parameters": "ipv6-address",
            "Info": "Specifies the tertiary IPv6 address of a location. Values-ipv6-address:."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no tertiary-ipv6-address"
}
{
    "PageTitle": "disable-capability-negotiation",
    "FuncDef": "This command disables capability negotiation. When the command is enabled and after the peering is flapped, any new capabilities are not negotiated and will strictly support IPv4 routing exchanges with that peer.",
    "CLIs": [
        "disable-capability-negotiation",
        "no disable-capability-negotiation"
    ],
    "ParentView": [
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no disable-capability-negotiation"
}
{
    "PageTitle": "override-tunnel-elc",
    "FuncDef": "This command enables or disables entropy label capability (ELC) on BGP tunnels.",
    "CLIs": [
        "override-tunnel-elc",
        "no override-tunnel-elc"
    ],
    "ParentView": [
        "config>router>bgp"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no override-tunnel-elc"
}
{
    "PageTitle": "rapid-update",
    "FuncDef": "This command enables and disables BGP rapid update for specified address families.",
    "CLIs": [
        "rapid-update [ l2-vpn ] [ mvpn-ipv4 ] [ mvpn-ipv6 ] [ mdt-safi ] [ evpn ] [ label-ipv4 ] [ label-ipv6 ] [ vpn-ipv4 ] [ vpn-ipv6 ] [ mcast-vpn-ipv4 ] [ mcast-vpn-ipv6 ]",
        "no rapid-update"
    ],
    "ParentView": [
        "config>router>bgp"
    ],
    "ParaDef": [
        {
            "Parameters": "l2-vpn",
            "Info": "Specifies the BGP rapid update for the 12-byte Virtual Switch Instance identifier (VSI-ID) value consisting of the 8-byte route distinguisher (RD) followed by a 4-byte value."
        },
        {
            "Parameters": "mvpn-ipv4",
            "Info": "Specifies BGP rapid update for the mvpn-ipv4 address family. The mvpn-pv4 address is a variable size value consisting of the 1-byte route type, 1-byte length and variable size that is route type specific. Route type defines encoding for the route type specific field. Length indicates the length in octets of the route type specific field."
        },
        {
            "Parameters": "mdt-safi",
            "Info": "Specifies BGP rapid update for the mdt-safi address family. The address is a 16-byte value consisting of 12-byte route distinguisher (RD) followed by a 4-byte group address."
        },
        {
            "Parameters": "mvpn-ipv6",
            "Info": "Specifies BGP rapid update for the mvpn-ipv6 address family."
        },
        {
            "Parameters": "evpn",
            "Info": "Specifies BGP rapid update for the evpn address family by including or removing EVPN routes from the set of routes that can trigger rapid update."
        },
        {
            "Parameters": "label-ipv4",
            "Info": "Includes or removes label-ipv4 routes from the set of routes that can trigger rapid update."
        },
        {
            "Parameters": "label-ipv6",
            "Info": "Includes or removes label-ipv6 routes from the set of routes that can trigger rapid update."
        },
        {
            "Parameters": "vpn-ipv4",
            "Info": "Includes or removes vpn-ipv4 routes from the set of routes that can trigger rapid update."
        },
        {
            "Parameters": "vpn-ipv6",
            "Info": "Includes or removes vpn-ipv6 routes from the set of routes that can trigger rapid update."
        },
        {
            "Parameters": "mcast-vpn-ipv4",
            "Info": "Includes or removes mcast-vpn-ipv4 routes from the set of routes that can trigger rapid update."
        },
        {
            "Parameters": "mcast-vpn-ipv6",
            "Info": "Includes or removes mcast-vpn-ipv6 routes from the set of routes that can trigger rapid update."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no rapid-update"
}
{
    "PageTitle": "vpn-ipv6",
    "FuncDef": "This command configures the add-paths capability for VPN-IPv6 routes. By default, add-paths is not enabled for VPN-IPv6 routes.",
    "CLIs": [
        "vpn-ipv6 send <send-limit> receive [ none ]",
        "vpn-ipv6 send <send-limit>",
        "no vpn-ipv6"
    ],
    "ParentView": [
        "config>router>bgp>add-paths",
        "config>router>bgp>group>add-paths",
        "config>router>bgp>group>neighbor>add-paths"
    ],
    "ParaDef": [
        {
            "Parameters": "send-limit",
            "Info": "Specifies the maximum number of paths per VPN-IPv6 NLRI that are allowed to be advertised to add-paths peers (the actual number of advertised routes may be less depending on the next-hop diversity requirement, other configuration options, route policies and/or route advertisement rules). Values-1 to 16, none."
        },
        {
            "Parameters": "receive",
            "Info": "Specifies that the router negotiates the add-paths receive capability for VPN-IPv6 routes with its peers."
        },
        {
            "Parameters": "none",
            "Info": "Specifies that the router does not negotiate the add-paths receive capability for VPN-IPv6 routes with its peers."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no vpn-ipv6"
}
{
    "PageTitle": "rapid-withdrawal",
    "FuncDef": "This command disables the delay (Minimum Route Advertisement) on sending BGP withdrawals. Normal route withdrawals may be delayed up to the minimum route advertisement to allow for efficient packing of BGP updates.",
    "CLIs": [
        "rapid-withdrawal",
        "no rapid-withdrawal"
    ],
    "ParentView": [
        "config>router>bgp"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no rapid-withdrawal"
}
{
    "PageTitle": "allow-static",
    "FuncDef": "This command allows the BGP next-hop of label-IPv4, label-IPv6, VPN-IPv4, and VPN-IPv6 routes received from any EBGP or IBGP peer to be resolved using static routes, except for static default routes (0/0 and ::/0).",
