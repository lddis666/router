        "BGP view"
    ],
    "ParaDef": [
        {
            "Parameters": "ipv4",
            "Info": "Next hop preferred IPv4 route.\n-"
        },
        {
            "Parameters": "ipv6",
            "Info": "Next hop preferred IPv6 route.\n-"
        }
    ],
    "Examples": [
        [
            "<HUAWEI> system-view",
            "[~HUAWEI] bgp 100",
