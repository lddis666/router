        "maximum load-balancing ebgp <ebgpNumber> ecmp-nexthop-changed",
        "maximum load-balancing ibgp <ibgpNumber> ecmp-nexthop-changed",
        "undo maximum load-balancing",
        "undo maximum load-balancing ebgp",
