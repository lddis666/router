input_text
You are an expert assistant in configuring network devices. Based on the user's request and the retrieved content from the router configuration manual below, generate appropriate CLI configuration commands.

---

User Request:  
"How to configure a Nokia router to advertise up to 8 paths per multicast IPv6 VPN prefix and negotiate to receive multiple routes for this prefix?"

Retrieved Reference Content (from the configuration manual):  
{
    "PageTitle": "remove-private",
    "FuncDef": "This command allows private AS numbers to be removed from the AS path before advertising them to BGP peers.",
    "CLIs": [
        "remove-private [ limited ] [ skip-peer-as ]",
        "no remove-private"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "limited",
            "Info": "This optional keyword removes private ASNs up to the first public ASN encountered. It then stops removing private ASNs."
        },
        {
            "Parameters": "skip-peer-as",
            "Info": "This optional keyword causes this command to not remove a private ASN from the AS-Path if that ASN is the same as the BGP peer AS number."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no remove-private"
}
{
    "PageTitle": "shutdown",
    "FuncDef": "This command administratively disables an entity. When disabled, an entity does not change, reset, or remove any configuration settings or statistics.",
    "CLIs": [
        "shutdown",
        "no shutdown"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor",
        "config>router>bgp>monitor",
        "config>bmp",
        "config>bmp>station",
        "config>bmp>station>connection>tcp-keepalive",
        "config>router>bgp>monitor",
        "config>router>bgp>group>monitor",
        "config>router>bgp>group>neighbor>monitor",
        "config>service>vprn>bgp>monitor",
        "config>service>vprn>bgp>group>monitor",
        "config>service>vprn>bgp>group>neighbor>monitor"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": ""
}
{
    "PageTitle": "neighbor-trust",
    "FuncDef": "This command enables a label security feature for prefixes of a VPN family at an inter-AS boundary.",
    "CLIs": [
        "neighbor-trust [ vpn-ipv4 ] [ vpn-ipv6 ]",
        "no neighbor-trust"
    ],
    "ParentView": [
        "config>router>bgp"
    ],
    "ParaDef": [
        {
            "Parameters": "vpn-ipv4",
            "Info": "Enables the inter-AS label security for VPN IPv4 family."
        },
        {
            "Parameters": "vpn-ipv6",
            "Info": "Enables the inter-AS label security for VPN IPv6 family."
        }
    ],
    "Examples": null,
    "ExtraInfo": ""
}
{
    "PageTitle": "family",
    "FuncDef": "This command configures the address families that are reported to a BMP monitoring station.",
    "CLIs": [
        "family [ ipv4 ] [ ipv6 ] [ label-ipv4 ] [ label-ipv6 ] [ vpn-ipv4 ] [ vpn-ipv6 ]",
        "no family"
    ],
    "ParentView": [
        "config>bmp>station"
    ],
    "ParaDef": [
        {
            "Parameters": "ipv4",
            "Info": "Adds support for the IPv4 unicast (unlabeled) address family."
        },
