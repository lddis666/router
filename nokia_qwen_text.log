            "Info": "Adds support for the EVPN address family."
        },
        {
            "Parameters": "bgp-ls",
            "Info": "Enables the advertisement of BGP-LS address family to the associated BGP neighbors."
        },
        {
            "Parameters": "mcast-ipv6",
            "Info": "Adds support for the IPv6 multicast SAFI address family."
        },
        {
            "Parameters": "mcast-vpn-ipv6",
            "Info": "Adds support for the IPv6 multicast routes from a VPRN over the provider network. This family is only applicable in the base BGP routing context."
        },
        {
            "Parameters": "sr-policy-ipv4",
            "Info": "Advertises the capability for AFI1/SAFI73, which corresponds to BGP routes that encode a segment routing policy to an IPv4 destination."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: family ipv4"
}
