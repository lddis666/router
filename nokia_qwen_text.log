    "ParaDef": [
        {
            "Parameters": "ipv4-address",
            "Info": "Specifies the IPv4 address of a peer.\nThe value is in dotted decimal notation."
        },
        {
            "Parameters": "disable",
            "Info": "Disables the Large-Community attribute from being advertised to a BGP peer.\n-"
        }
    ],
    "Examples": [
