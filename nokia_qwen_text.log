    "FuncDef": "This command configures the set of BGP address families (AFI plus SAFI) to be supported by the applicable base router BGP sessions.",
    "CLIs": [
        "family [ ipv4 ] [ label-ipv4 ] [ vpn-ipv4 ] [ ipv6 ] [ label-ipv6 ] [ vpn-ipv6 ] [ mcast-ipv4 ] [ l2-vpn ] [ mvpn-ipv4 ] [ mvpn-ipv6 ] [ mdt-safi ] [ ms-pw ] [ flow-ipv4 ] [ flow-ipv6 ] [ route-target ] [ mcast-vpn-ipv4 ] [ evpn ] [ bgp-ls ] [ mcast-ipv6 ] [ mcast-vpn-ipv6 ] [ sr-policy-ipv4 ]",
        "no family"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "ipv4",
            "Info": "Adds support for the IPv4 unicast (unlabeled) address family."
        },
        {
            "Parameters": "label-ipv4",
            "Info": "Adds support for the IPv4 unicast (labeled) address family."
        },
        {
            "Parameters": "vpn-ipv4",
            "Info": "Adds support for the IPv4 VPN (SAFI 128) address family."
        },
        {
            "Parameters": "ipv6",
            "Info": "Adds support for the IPv6 unicast (unlabeled) address family."
        },
        {
            "Parameters": "label-ipv6",
            "Info": "Adds support for the IPv6 unicast (labeled) address family."
        },
        {
            "Parameters": "vpn-ipv6",
            "Info": "Adds support for the IPv6 VPN (SAFI 128) address family."
        },
        {
            "Parameters": "mcast-ipv4",
            "Info": "Adds support for the IPv4 multicast SAFI address family."
        },
        {
            "Parameters": "l2-vpn",
            "Info": "Adds support for the L2 VPN address family."
        },
        {
            "Parameters": "mvpn-ipv4",
            "Info": "Adds support for the IPv4 multicast VPN address family."
        },
        {
            "Parameters": "mvpn-ipv6",
            "Info": "Adds support for the IPv6 multicast VPN address family."
        },
        {
            "Parameters": "mdt-safi",
            "Info": "Adds support for the MDT SAFI address family."
        },
        {
            "Parameters": "ms-pw",
            "Info": "Adds support for the multi-segment pseudowire address family."
        },
        {
            "Parameters": "flow-ipv4",
            "Info": "Adds support for the IPv4 flowspec address family."
        },
        {
            "Parameters": "flow-ipv6",
            "Info": "Adds support for the IPv6 flowspec address family."
        },
        {
            "Parameters": "route-target",
            "Info": "Adds support for the address family for RT constrain routes."
        },
        {
            "Parameters": "mcast-vpn-ipv4",
            "Info": "Adds support for the IPv4 VPN multicast (SAFI 129) address family."
        },
        {
            "Parameters": "evpn",
            "Info": "Adds support for the EVPN address family."
        },
        {
            "Parameters": "bgp-ls",
            "Info": "Enables the advertisement of BGP-LS address family to the associated BGP neighbors."
        },
        {
            "Parameters": "mcast-ipv6",
            "Info": "Adds support for the IPv6 multicast SAFI address family."
        },
        {
            "Parameters": "mcast-vpn-ipv6",
            "Info": "Adds support for the IPv6 multicast routes from a VPRN over the provider network. This family is only applicable in the base BGP routing context."
        },
        {
            "Parameters": "sr-policy-ipv4",
            "Info": "Advertises the capability for AFI1/SAFI73, which corresponds to BGP routes that encode a segment routing policy to an IPv4 destination."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: family ipv4"
}
