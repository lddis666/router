            "Parameters": "limited",
            "Info": "This optional keyword removes private ASNs up to the first public ASN encountered. It then stops removing private ASNs."
        },
        {
            "Parameters": "skip-peer-as",
            "Info": "This optional keyword causes this command to not remove a private ASN from the AS-Path if that ASN is the same as the BGP peer AS number."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no remove-private"
}
