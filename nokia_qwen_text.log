    "PageTitle": "send-orf",
    "FuncDef": "This command instructs the router to negotiate the send capability in the BGP outbound route filtering (ORF) negotiation with a peer.",
    "CLIs": [
        "send-orf [ <comm-id> ]",
        "no send-orf [ <comm-id> ]"
    ],
    "ParentView": [
        "config>router>bgp>outbound-route-filtering>extended-community",
