input_text
You are an expert assistant in configuring network devices. Based on the user's request and the retrieved content from the router configuration manual below, generate appropriate CLI configuration commands.

---

User Request:  
How to configure Nokia routers to generate a warning message when receiving 5000 IPv6 routes from a BGP peer, with a threshold alert at 80% capacity, without terminating the session?

Retrieved Reference Content (from the configuration manual):  
{
    "PageTitle": "shutdown",
    "FuncDef": "This command administratively disables an entity. When disabled, an entity does not change, reset, or remove any configuration settings or statistics.",
    "CLIs": [
        "shutdown",
        "no shutdown"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor",
        "config>router>bgp>monitor",
        "config>bmp",
        "config>bmp>station",
        "config>bmp>station>connection>tcp-keepalive",
        "config>router>bgp>monitor",
        "config>router>bgp>group>monitor",
        "config>router>bgp>group>neighbor>monitor",
        "config>service>vprn>bgp>monitor",
        "config>service>vprn>bgp>group>monitor",
        "config>service>vprn>bgp>group>neighbor>monitor"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": ""
}
{
    "PageTitle": "dynamic-neighbor-limit",
    "FuncDef": "This command configures the maximum number of dynamic BGP sessions that will be accepted from remote peers associated with the entire BGP instance or a specific peer group. If accepting a new dynamic session would cause either the group limit or the instance limit to be exceeded, then the new session attempt is rejected and a Notification message is sent back to the remote peer.",
    "CLIs": [
        "dynamic-neighbor-limit <peers>",
        "no dynamic-neighbor-limit"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group"
    ],
    "ParaDef": [
        {
            "Parameters": "peers",
            "Info": "The maximum number of dynamic BGP sessions. Values-1 to 8192."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no dynamic-neighbor-limit"
}
{
    "PageTitle": "family",
    "FuncDef": "This command configures the address family context for configuring next-hop resolution of BGP label routes.",
    "CLIs": [
        "family { label-ipv4 | label-ipv6 | vpn }"
    ],
    "ParentView": [
        "config>router>bgp>next-hop-resolution>labeled-routes>transport-tunnel"
    ],
    "ParaDef": [
        {
            "Parameters": "label-ipv4",
            "Info": "Enters the context for configuring next-hop-resolution options for labeled-unicast IPv4 routes."
        },
        {
            "Parameters": "label-ipv6",
            "Info": "Enters the context for configuring next-hop-resolution options for labeled-unicast IPv6 routes."
        },
        {
            "Parameters": "vpn",
            "Info": "Enters the context for configuring next-hop-resolution options for VPN-IPv4 and VPN-IPv6 routes when they are not imported into any VPRN service."
        }
    ],
    "Examples": null,
    "ExtraInfo": ""
}
