{'Parameters': 'mvpn-ipv6', 'Info': 'Adds support for the IPv6 multicast VPN address family.'}
{'Parameters': 'mdt-safi', 'Info': 'Adds support for the MDT SAFI address family.'}
{'Parameters': 'ms-pw', 'Info': 'Adds support for the multi-segment pseudowire address family.'}
{'Parameters': 'flow-ipv4', 'Info': 'Adds support for the IPv4 flowspec address family.'}
{'Parameters': 'flow-ipv6', 'Info': 'Adds support for the IPv6 flowspec address family.'}
{'Parameters': 'route-target', 'Info': 'Adds support for the address family for RT constrain routes.'}
{'Parameters': 'mcast-vpn-ipv4', 'Info': 'Adds support for the IPv4 VPN multicast (SAFI 129) address family.'}
{'Parameters': 'evpn', 'Info': 'Adds support for the EVPN address family.'}
