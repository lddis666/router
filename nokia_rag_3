            shortcut-tunn
                family ipv4
                    resolution-filter
                        sr-policy
                    exit
                exit
            exit
            labeled-routes
                transport-tunnel
                    family ipv4
                        resolution-filter
                            sr-policy
                        exit
                    exit
                exit
            exit
