```cli
configure router
    policy-options
        begin
        prefix-list "DEFAULT_ROUTE"
            prefix 0.0.0.0/0 exact
        exit
        policy-statement "ADVERTISE_DEFAULT"
            entry 10
                from
                    prefix-list "DEFAULT_ROUTE"
                exit
                action accept
                exit
            exit
        commit
