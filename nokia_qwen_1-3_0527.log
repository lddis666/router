        "config>router>bgp>next-hop-resolution>labeled-routes>transport-tunnel"
    ],
    "ParaDef": [
        {
            "Parameters": "label-ipv4",
            "Info": "Enters the context for configuring next-hop-resolution options for labeled-unicast IPv4 routes."
        },
        {
            "Parameters": "label-ipv6",
            "Info": "Enters the context for configuring next-hop-resolution options for labeled-unicast IPv6 routes."
        },
        {
            "Parameters": "vpn",
            "Info": "Enters the context for configuring next-hop-resolution options for VPN-IPv4 and VPN-IPv6 routes when they are not imported into any VPRN service."
        }
    ],
    "Examples": null,
    "ExtraInfo": ""
}
{
    "PageTitle": "router",
    "FuncDef": "This command configures the router instance to be used to connect to the associate BMP monitoring station.",
