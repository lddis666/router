You are an expert assistant in configuring network devices. Based on the user's request and the retrieved content from the router configuration manual below, generate appropriate CLI configuration commands.

---

User Request:  
How to configure next-hop-resolution options for labeled-unicast IPv6 routes on a Nokia router?

Retrieved Reference Content (from the configuration manual):  
{
    "PageTitle": "label-ipv4",
    "FuncDef": "This command configures the add-paths capability for labeled-unicast IPv4 routes. By default, add-paths is not enabled for labeled-unicast IPv4 routes.",
    "CLIs": [
        "label-ipv4 send <send-limit>",
        "label-ipv4 send <send-limit> receive [ none ]",
        "no label-ipv4"
    ],
    "ParentView": [
        "config>router>bgp>add-paths",
        "config>router>bgp>group>add-paths",
        "config>router>bgp>group>neighbor>add-paths"
    ],
    "ParaDef": [
        {
            "Parameters": "send-limit",
            "Info": "Specifies the maximum number of paths per labeled-unicast IPv4 prefix that are allowed to be advertised to add-paths peers. (The actual number of advertised routes may be less.) If the value is none, the router does not negotiate the send capability with respect to label-IPv4 AFI/SAFI. Values-1 to 16, none."
        },
        {
            "Parameters": "receive",
            "Info": "Specifies the router negotiates to receive multiple labeled-unicast routes per IPv4 prefix."
        },
        {
            "Parameters": "none",
            "Info": "Specifies that the router does not negotiate to receive multiple labeled-unicast routes per IPv4 prefix."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no label-ipv4"
}
{
    "PageTitle": "export",
    "FuncDef": "This command specifies route policies that control the handling of outbound routes transmitted to certain peers. Route policies are configured in theconfig>router>policy-optionscontext.",
    "CLIs": [
        "export <plcy-or-long-expr> [ <plcy-or-expr> [ <plcy-or-expr> ] ]",
        "no export [ <plcy-or-long-expr> ]"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "plcy-or-long-expr",
            "Info": "Specifies the route policy name (up to 64 characters) or a policy logical expression (up to 255 characters long). Allowed values are any string up to 255 characters long composed of printable, 7-bit ASCII characters. If the string contains special characters (#, $, spaces, and so on), the entire string must be enclosed within double quotes."
        },
        {
            "Parameters": "plcy-or-expr",
            "Info": "Specifies up to 14 route policy names (up to 64 characters each) or a policy logical expression (up to 64 characters long). Allowed values are any string up to 64 characters long composed of printable, 7-bit ASCII characters. If the string contains special characters (#, $, spaces, and so on), the entire string must be enclosed within double quotes."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no export"
}
