{
    "PageTitle": "third-party-nexthop",
    "FuncDef": "Use this command to enable the router to send third-party next-hop to EBGP peers in the same subnet as the source peer, as described in RFC 4271. If enabled when an IPv4 or IPv6 route is received from one EBGP peer and advertised to another EBGP peer in the same IP subnet, the BGP next-hop is left unchanged. Third-party next-hop is not done if the address family of the transport does not match the address family of the route.",
    "CLIs": [
        "third-party-nexthop",
        "no third-party-nexthop"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no third-party-nexthop"
}
{
    "PageTitle": "next-hop-self",
    "FuncDef": "This command configures BGP to advertise routes to members of a group or to a specific neighbor using a local address of the BGP instance as the BGP next-hop address. Note thatnext-hop-selfis set without exception, regardless of the route source (EBGP or IBGP) or its family. When used with VPN-IPv4 and VPN-IPv6 routes theenable-rr-vpn-forwardingcommand should also be configured.",
    "CLIs": [
        "next-hop-self",
        "no next-hop-self"
    ],
    "ParentView": [
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no next-hop-self"
}
{
    "PageTitle": "export",
    "FuncDef": "This command specifies route policies that control the handling of outbound routes transmitted to certain peers. Route policies are configured in theconfig>router>policy-optionscontext.",
    "CLIs": [
        "export <plcy-or-long-expr> [ <plcy-or-expr> [ <plcy-or-expr> ] ]",
        "no export [ <plcy-or-long-expr> ]"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "plcy-or-long-expr",
            "Info": "Specifies the route policy name (up to 64 characters) or a policy logical expression (up to 255 characters long). Allowed values are any string up to 255 characters long composed of printable, 7-bit ASCII characters. If the string contains special characters (#, $, spaces, and so on), the entire string must be enclosed within double quotes."
        },
        {
            "Parameters": "plcy-or-expr",
            "Info": "Specifies up to 14 route policy names (up to 64 characters each) or a policy logical expression (up to 64 characters long). Allowed values are any string up to 64 characters long composed of printable, 7-bit ASCII characters. If the string contains special characters (#, $, spaces, and so on), the entire string must be enclosed within double quotes."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no export"
}
{
    "PageTitle": "bgp",
    "FuncDef": "This command creates the BGP protocol instance and BGP configuration context. BGP is administratively enabled upon creation.",
    "CLIs": [
        "bgp",
        "no bgp"
    ],
    "ParentView": [
        "config>router"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": ""
}
