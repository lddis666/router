{
    "PageTitle": "family",
    "FuncDef": "This command configures the address families that are reported to a BMP monitoring station.",
    "CLIs": [
        "family [ ipv4 ] [ ipv6 ] [ label-ipv4 ] [ label-ipv6 ] [ vpn-ipv4 ] [ vpn-ipv6 ]",
        "no family"
    ],
    "ParentView": [
        "config>bmp>station"
    ],
    "ParaDef": [
        {
            "Parameters": "ipv4",
            "Info": "Adds support for the IPv4 unicast (unlabeled) address family."
        },
        {
            "Parameters": "ipv6",
            "Info": "Adds support for the IPv6 unicast (unlabeled) address family."
        },
        {
            "Parameters": "label-ipv4",
            "Info": "Adds support for the IPv4 unicast (labeled) address family."
        },
        {
            "Parameters": "label-ipv6",
            "Info": "Adds support for the IPv6 unicast (labeled) address family."
        },
        {
            "Parameters": "vpn-ipv4",
            "Info": "Adds support for the IPv4 VPN (SAFI 128) address family."
        },
        {
            "Parameters": "vpn-ipv6",
            "Info": "Adds support for the IPv6 VPN (SAFI 128) address family."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: family ipv4"
}
{
    "PageTitle": "vpn-ipv4",
    "FuncDef": "This command configures the add-paths capability for VPN-IPv4 routes. By default, add-paths is not enabled for VPN-IPv4 routes.",
    "CLIs": [
        "vpn-ipv4 send <send-limit> receive [ none ]",
        "vpn-ipv4 send <send-limit>",
        "no vpn-ipv4"
    ],
    "ParentView": [
        "config>router>bgp>add-paths",
        "config>router>bgp>group>add-paths",
        "config>router>bgp>group>neighbor>add-paths"
    ],
    "ParaDef": [
        {
            "Parameters": "send-limit",
            "Info": "Specifies the maximum number of paths per VPN-IPv4 NLRI that are allowed to be advertised to add-paths peers (the actual number of advertised routes may be less depending on the next-hop diversity requirement, other configuration options, route policies and/or route advertisement rules). Values-1 to 16, none."
        },
        {
            "Parameters": "receive",
            "Info": "Specifies that the router negotiates the add-paths receive capability for VPN-IPv4 routes with its peers."
        },
        {
            "Parameters": "none",
            "Info": "Specifies that the router does not negotiate the Add-Paths receive capability for VPN-IPv4 routes with its peers."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no vpn-ipv4"
}
{
    "PageTitle": "route-table-import",
    "FuncDef": "This command specifies the name of a route to control the importation of active routes from the IP route table into one of the BGP RIBs.",
    "CLIs": [
        "route-table-import <policy-name>",
        "no route-table-import"
    ],
    "ParentView": [
        "config>router>bgp>rib-management>ipv4",
        "config>router>bgp>rib-management>label-ipv4",
        "config>router>bgp>rib-management>ipv6",
        "config>router>bgp>rib-management>label-ipv6"
    ],
    "ParaDef": [
        {
            "Parameters": "policy-name",
            "Info": "Specifies the name of a policy-statement (up to 64 characters)."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no route-table-import"
}
{
    "PageTitle": "ipv6",
    "FuncDef": "This command configures the add-paths capability for unlabeled IPv6 unicast routes. By default, add-paths is not enabled for unlabeled IPv6 unicast routes.",
    "CLIs": [
        "ipv6 send <send-limit> receive [ none ]",
        "ipv6 send <send-limit>",
        "no ipv6"
    ],
    "ParentView": [
        "config>router>bgp>add-paths",
        "config>router>bgp>group>add-paths",
        "config>router>bgp>group>neighbor>add-paths"
    ],
    "ParaDef": [
        {
            "Parameters": "send send-limit",
            "Info": "Specifies the maximum number of paths per unlabeled IPv6 unicast prefix that are allowed to be advertised to add-paths peers. (The actual number of advertised routes may be less.) If the value is none, the router does not negotiate the send capability with respect to IPv6 AFI/SAFI. Values-1 to 16, none."
        },
        {
            "Parameters": "receive",
            "Info": "Specifies the router negotiates to receive multiple unlabeled unicast routes per IPv6 prefix."
        },
        {
            "Parameters": "none",
            "Info": "Specifies the router does not negotiate to receive multiple unlabeled unicast routes per IPv6 prefix."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no ipv6"
}
