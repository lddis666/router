input_text
You are an expert assistant in configuring network devices. Based on the user's request and the retrieved content from the router configuration manual below, generate appropriate CLI configuration commands.

---

User Request:  
How to configure Nokia routers to advertise IPv6 multicast routes from a VPRN over the provider network using BGP?

Retrieved Reference Content (from the configuration manual):  
{
    "PageTitle": "advertise-ipv6-next-hops",
    "FuncDef": "This command applies to a BGP session established on top of IPv6; transport, BGP routes belonging to the specified families can be advertised with a true IPv6 address when originated or whennext-hop-self(configured or automatic) is applied.",
    "CLIs": [
        "advertise-ipv6-next-hops [ vpn-ipv6 ] [ label-ipv6 ] [ vpn-ipv4 ] [ label-ipv4 ]",
        "no advertise-ipv6-next-hops"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "vpn-ipv6",
            "Info": "Allows VPN IPv6 routes to be advertised to IPv6 transport peers with an IPv6 address as the BGP next hop in cases of route origination or next-hop-self (configured or automatic)."
        },
        {
            "Parameters": "label-ipv6",
            "Info": "Allows label IPv6 routes to be advertised to IPv6 transport peers with an IPv6 address as the BGP next hop in cases of route origination or next-hop-self (configured or automatic)."
        },
        {
            "Parameters": "vpn-ipv4",
            "Info": "Allows VPN IPv4 routes to be advertised to IPv6 transport peers with an IPv6 address as the BGP next hop in cases of route origination or next-hop-self (configured or automatic). It also allows export policies to change the BGP next hop of a VPN IPv4 route to an IPv6 address. All of these cases require the remote peer to advertise the necessary extended NH encoding capability."
        },
        {
            "Parameters": "label-ipv4",
            "Info": "Allows label IPv4 routes to be advertised to IPv6 transport peers with an IPv6 address as the BGP next hop in cases of route origination or next-hop-self (configured or automatic). It also allows export policies to change the BGP next hop of a label IPv4 route to an IPv6 address. All of these cases require the remote peer to advertise the necessary extended NH encoding capability."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: no advertise-ipv6-next-hops"
}
{
    "PageTitle": "local-address",
    "FuncDef": "This command configures the local IP address used by the local router when communicating with the BMP monitoring station. This configuration is optional.",
    "CLIs": [
        "local-address { <ip-address> | <ipv6-address> }",
        "no local-address"
    ],
    "ParentView": [
        "config>bmp>station>connection"
    ],
    "ParaDef": [
        {
            "Parameters": "ip-address",
            "Info": "Specifies the local address expressed in dotted decimal notation. Allowed value is a valid routable IP address on the router, either an interface or system IP address. Values-ipv4-address:."
        },
        {
            "Parameters": "ipv6-address",
            "Info": "Specifies the local address expressed in dotted decimal notation. Allowed value is a valid routable IPv6 address on the router, either an interface or system IPv6 address. Values-ipv6-address:."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: local-address ip-address (system IP address)"
}
{
    "PageTitle": "prefix-limit",
    "FuncDef": "This command configures the maximum number of BGP routes that can be received from a peer before some administrative action is taken. The administrative action can be the generation of a log event or taking down the session. If a session is taken down, then it can be brought back up automatically after an idle-timeout period, or else it can be configured to stay down ('forever') until the operator performs a reset.",
    "CLIs": [
        "prefix-limit <family> <limit> [ threshold <percentage> ] [ idle-timeout { <minutes> | forever } | log-only ] [ post-import ]",
        "no prefix-limit <family>"
    ],
    "ParentView": [
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": [
        {
            "Parameters": "log-only",
            "Info": "Enables the warning message to be sent at the specified threshold percentage, and also when the limit is reached. However, the BGP session is not taken down."
        },
        {
            "Parameters": "percentage",
            "Info": "Specifies the threshold value (as a percentage) that triggers a warning message to be sent. Values-1 to 100."
        },
        {
            "Parameters": "family",
            "Info": "Specifies the address family to which the limit applies. Values-ipv4, label-ipv4, vpn-ipv4, ipv6, label-ipv6, vpn-ipv6, mcast-ipv4, l2-vpn, mvpn-ipv4, mdt-safi, ms-pw, flow-ipv4, route-target, mcast-vpn-ipv4, mvpn-ipv6, flow-ipv6, evpn, mcast-ipv6, bgp-ls."
        },
        {
            "Parameters": "limit",
            "Info": "Specifies the number of routes that can be learned from a peer expressed as a decimal integer. Values-1 to 4294967295."
        },
        {
            "Parameters": "minutes",
            "Info": "Specifies duration in minutes before automatically re-establishing a session. Values-1 to 1024."
        },
        {
            "Parameters": "forever",
            "Info": "Specifies that the session is reestablished only after clear router bgp command is executed."
        },
        {
            "Parameters": "post-import",
            "Info": "Specifies that the limit should be applied only to the number of routes that are accepted by import policies."
        }
    ],
    "Examples": null,
    "ExtraInfo": ""
}
{
    "PageTitle": "outbound-route-filtering",
    "FuncDef": "This command opens the configuration tree for sending or accepting BGP filter lists from peers (outbound route filtering).",
    "CLIs": [
        "outbound-route-filtering",
        "no outbound-route-filtering"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no outbound-route-filtering"
}
{
    "PageTitle": "vpn-apply-export",
    "FuncDef": "This command causes the base instance BGP export route policies to be applied to vpn-ipv4/6, mvpn-ipv4/6, l2-vpn, mdt-safi, mcast-vpn-ipv4, and evpn routes.",
    "CLIs": [
        "vpn-apply-export",
        "no vpn-apply-export"
    ],
    "ParentView": [
        "config>router>bgp",
        "config>router>bgp>group",
        "config>router>bgp>group>neighbor"
    ],
    "ParaDef": null,
    "Examples": null,
    "ExtraInfo": "Default: no vpn-apply-export"
}
{
    "PageTitle": "purge-timer",
    "FuncDef": "When the system sends a VPN-IP Route-Refresh to a peer it sets all the VPN-IP routes received from that peer (in the RIB-IN) to stale and starts the purge-timer. If the routes are not updated (refreshed) before the purge-timer has expired then the routes are removed.",
    "CLIs": [
        "purge-timer <minutes>",
        "no purge-timer"
    ],
    "ParentView": [
        "config>router>bgp"
    ],
    "ParaDef": [
        {
            "Parameters": "minutes",
            "Info": "Specifies the maximum time before stale routes are purged. Values-1 to 60."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: purge-timer 10"
}
{
    "PageTitle": "family",
    "FuncDef": "This command configures the address families that are reported to a BMP monitoring station.",
    "CLIs": [
        "family [ ipv4 ] [ ipv6 ] [ label-ipv4 ] [ label-ipv6 ] [ vpn-ipv4 ] [ vpn-ipv6 ]",
        "no family"
    ],
    "ParentView": [
        "config>bmp>station"
    ],
    "ParaDef": [
        {
            "Parameters": "ipv4",
            "Info": "Adds support for the IPv4 unicast (unlabeled) address family."
        },
        {
            "Parameters": "ipv6",
            "Info": "Adds support for the IPv6 unicast (unlabeled) address family."
        },
        {
            "Parameters": "label-ipv4",
            "Info": "Adds support for the IPv4 unicast (labeled) address family."
        },
        {
            "Parameters": "label-ipv6",
            "Info": "Adds support for the IPv6 unicast (labeled) address family."
        },
        {
            "Parameters": "vpn-ipv4",
            "Info": "Adds support for the IPv4 VPN (SAFI 128) address family."
        },
        {
            "Parameters": "vpn-ipv6",
            "Info": "Adds support for the IPv6 VPN (SAFI 128) address family."
        }
    ],
    "Examples": null,
    "ExtraInfo": "Default: family ipv4"
}
{
    "PageTitle": "family",
    "FuncDef": "This command configures family-specific LLGR parameters for BGP peers.",
    "CLIs": [
        "family { ipv4 | ipv6 | label-ipv4 | label-ipv6 | vpn-ipv4 | vpn-ipv6 | l2-vpn | route-target | flow-ipv4 | flow-ipv6 }",
        "no family { ipv4 | ipv6 | label-ipv4 | label-ipv6 | vpn-ipv4 | vpn-ipv6 | l2-vpn | route-target | flow-ipv4 | flow-ipv6 }"
