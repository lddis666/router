{
    "PageTitle": "peer timer connect-retry (BGP-VPN instance IPv6 address family view) (group)",
    "FuncDef": "The peer timer connect-retry command sets a ConnectRetry interval for a peer group.\nThe undo peer timer connect-retry command restores the default setting.\nBy default, the ConnectRetry interval is 32s.",
    "CLIs": [
        "peer <group-name> timer connect-retry <connect-retry-time>",
        "undo peer <group-name> timer connect-retry"
    ],
