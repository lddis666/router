    "PageTitle": "vpn-apply-import",
    "FuncDef": "This command causes the base instance BGP import route policies to be applied to vpn-ipv4/6, mvpn-ipv4/6, l2-vpn, mdt-safi, mcast-vpn-ipv4, and evpn routes.",
    "CLIs": [
        "vpn-apply-import",
        "no vpn-apply-import"
    ],
    "ParentView": [
