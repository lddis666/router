            "Parameters": "vpn-ipv6",
            "Info": "Specifies the VPN IPv6 family."
        },
        {
            "Parameters": "l2-vpn",
            "Info": "Specifies the Layer 2 VPN family."
        },
        {
            "Parameters": "route-target",
            "Info": "Specifies the route target family."
        },
        {
            "Parameters": "flow-ipv4",
