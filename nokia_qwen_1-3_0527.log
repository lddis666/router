{
    "PageTitle": "family",
    "FuncDef": "This command configures the address families that are reported to a BMP monitoring station.",
    "CLIs": [
        "family [ ipv4 ] [ ipv6 ] [ label-ipv4 ] [ label-ipv6 ] [ vpn-ipv4 ] [ vpn-ipv6 ]",
        "no family"
    ],
    "ParentView": [
        "config>bmp>station"
    ],
    "ParaDef": [
        {
            "Parameters": "ipv4",
            "Info": "Adds support for the IPv4 unicast (unlabeled) address family."
        },
        {
            "Parameters": "ipv6",
            "Info": "Adds support for the IPv6 unicast (unlabeled) address family."
        },
        {
            "Parameters": "label-ipv4",
            "Info": "Adds support for the IPv4 unicast (labeled) address family."
