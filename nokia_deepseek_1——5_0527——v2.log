{
    "PageTitle": "route-monitoring",
    "FuncDef": "This command specifies if BMP sends pre-policy route monitoring messages, post-policy route monitoring messages, both types of messages, or none.",
    "CLIs": [
        "route-monitoring pre-policy [ post-policy ]",
        "route-monitoring post-policy",
        "no route-monitoring"
    ],
    "ParentView": [
        "config>router>bgp>monitor",
        "config>router>bgp>group>monitor",
        "config>router>bgp>group>neighbor>monitor",
        "config>service>vprn>bgp>monitor",
        "config>service>vrpn>bgp>group>monitor",
        "config>service>vrpn>bgp>group>monitor"
    ],
    "ParaDef": [
        {
            "Parameters": "pre-policy",
            "Info": "Enables sending pre-policy route monitoring messages using the pre-policy path attribute values, if available."
