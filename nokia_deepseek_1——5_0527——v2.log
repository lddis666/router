```json
{
    "commands": [
        "tunnel-policy bgp-resolve enable",
        "tunnel-policy bgp-resolve tunnel rsvp-te preference 100",
        "tunnel-policy bgp-resolve tunnel sr-te isis preference 200"
    ]
}
```
