            "Parameters": "ipv6",
            "Info": "Enables BGP fast reroute for unlabeled unicast IPv6 routes."
        },
        {
            "Parameters": "label-ipv4",
            "Info": "Enables BGP fast reroute for labeled-unicast IPv4 routes."
        },
        {
            "Parameters": "label-ipv6",
